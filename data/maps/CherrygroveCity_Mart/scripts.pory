mapscripts CherrygroveCity_Mart_MapScripts{}

script CherrygroveCity_Mart_EventScript_BallGuy{
    if(flag(FLAG_ADVENTURE_STARTED))
    {
        msgbox(CherrygroveCity_Mart_Text_BallGuy_InStock, MSGBOX_NPC)
        end
    }
	msgbox(CherrygroveCity_Mart_Text_BallGuy_OutOfStock, MSGBOX_NPC)
	end
}

script CherrygroveCity_Mart_EventScript_Youngster{
	msgbox(CherrygroveCity_Mart_Text_Youngster, MSGBOX_NPC)
	end
}

script CherrygroveCity_Mart_EventScript_Clerk{
	lock
    faceplayer
    message(gText_HowMayIHelpYou)
    waitmessage
    if(flag(FLAG_ADVENTURE_STARTED))
    {
        pokemart(CherrygroveCity_Mart_Pokemart_PostDex)
        msgbox(gText_PleaseComeAgain)
        release
        end
    }
	pokemart(CherrygroveCity_Mart_Pokemart_PreDex)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

text CherrygroveCity_Mart_Text_BallGuy_OutOfStock {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Se han quedado sin {POKE} BALLS!\n¿Cuándo conseguirán más?"
		_: "They're fresh out of {POKE} BALLS!\nWhen will they get more of them?"
	}
}

text CherrygroveCity_Mart_Text_BallGuy_InStock {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Ya hay {POKE} BALLS en stock!\n¡Ahora puedo capturar {POKEMON}!"
		_: "{POKE} BALLS are in stock!\nNow I can catch {POKEMON}!"
	}
}

text CherrygroveCity_Mart_Text_Youngster {
	poryswitch(LANGUAGE) {
		SPANISH: "Cuando iba por la hierba, un {POKEMON}\nbicho envenenó a mis {POKEMON}.\pYo seguí andando, pero mi {POKEMON}\nse debilitó.\pDeberías llevar un ANTÍDOTO\ncontigo."
		_: "When I was walking in the grass,\na BUG {POKEMON} popped out and\lpoisoned my {POKEMON}!\pI tried to keep going, but then my\n{POKEMON} fainted.\pYou should always keep an ANTIDOTE\nwith you, just in case."
	}
}

raw `
    .align 2
CherrygroveCity_Mart_Pokemart_PreDex:
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_NONE

	.align 2
CherrygroveCity_Mart_Pokemart_PostDex:
	.2byte ITEM_POKE_BALL
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_NONE
`
