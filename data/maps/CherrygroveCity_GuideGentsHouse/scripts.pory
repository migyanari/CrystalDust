mapscripts CherrygroveCity_GuideGentsHouse_MapScripts{}

script CherrygroveCity_GuideGentsHouse_EventScript_GuideGent{
	msgbox(CherrygroveCity_GuideGentsHouse_Text_GuideGent, MSGBOX_NPC)
	end
}

text CherrygroveCity_GuideGentsHouse_Text_GuideGent {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Cuando era niño, era un brillante\nENTRENADOR!\pÉste es mi consejo:\n¡Atrapa muchos {POKEMON}!\l¡Y trátalos con mucho cariño!"
		_: "When I was a wee lad, I was a\nhot-shot TRAINER!\pHere's a word of advice:\nCatch lots of {POKEMON}!\lTreat them all with kindness!"
	}
}
