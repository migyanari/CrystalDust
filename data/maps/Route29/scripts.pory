mapscripts Route29_MapScripts{
	MAP_SCRIPT_ON_TRANSITION{
		gettime
		if(!flag(FLAG_BADGE01_GET) || var(VAR_0x8003) != DAY_TUESDAY)
		{
			setflag(FLAG_TEMP_1)
		}
	}
}

// ---------------------------------------------------------------------------
// Scripts
// ---------------------------------------------------------------------------

script Route29_EventScript_Tuscany {
	lock
	faceplayer
	if (!flag(FLAG_RECEIVED_SILK_SCARF_FROM_TUSCANY))
	{
		gettime
		if (var(VAR_0x8003) == DAY_TUESDAY)
		{
			if (!flag(FLAG_MET_TUSCANY_OF_TUESDAY))
			{
				msgbox(Route29_Text_Tuscany_FirstMeeting)
				setflag(FLAG_MET_TUSCANY_OF_TUESDAY)
			}
			else
			{
				msgbox(Route29_Text_Tuscany_GiftIntro)
			}
			giveitem(ITEM_SILK_SCARF)
			if (!var(VAR_RESULT))
			{
				goto(Common_EventScript_ShowBagIsFull)
			}
			setflag(FLAG_RECEIVED_SILK_SCARF_FROM_TUSCANY)
			msgbox(Route29_Text_Tuscany_AfterGift)
		}
		else
		{
			msgbox(Route29_Text_Tuscany_NotTuesday)
		}
	}
	else
	{
		msgbox(Route29_Text_Tuscany_AlreadyReceived)
	}
	release
}

script Route29_EventScript_Youngster{
	msgbox(Route29_Text_Youngster, MSGBOX_NPC)
	end
}

script Route29_EventScript_LedgeGirl{
	msgbox(Route29_Text_LedgeGirl, MSGBOX_NPC)
	end
}

script Route29_EventScript_FatMan{
	msgbox(Route29_Text_FatMan, MSGBOX_NPC)
	end
}

script Route29_EventScript_WaitingMan{
	lock
	faceplayer
	gettime
	if(var(VAR_0x8002) == TIME_NIGHT)
	{
		bufferstring(0, Route29_Text_WaitingMan_MorningSuffix)
	}
	else
	{
		bufferstring(0, Route29_Text_WaitingMan_NightSuffix)
	}
	msgbox(Route29_Text_WaitingMan)
	release
	end
}

script Route29_EventScript_DirectionSign{
	msgbox(Route29_Text_DirectionSign, MSGBOX_SIGN)
	end
}

script Route29_EventScript_Dude{
	lock
	faceplayer
	if(flag(FLAG_LEARNED_TO_CATCH_POKEMON) || !flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
	{
		msgbox(Route29_Text_Dude_PokemonInGrass)
		release
		end
	}
	msgbox(Route29_Text_Dude_OfferTutorial, MSGBOX_YESNO)
	if(!var(VAR_RESULT))
	{
		msgbox(Route29_Text_Dude_CatchingTutRejected)
		release
		end
	}
	closemessage
	special(StartDudeTutorialBattle)
	waitstate
	lock //hack
	msgbox(Route29_Text_Dude_CatchingOutro)
	setflag(FLAG_LEARNED_TO_CATCH_POKEMON)
	release
	end
}

script Route29_EventScript_CatchingTutorialTriggers{
	lockall
	getplayerxy(VAR_RESULT, VAR_TEMP_1)
	turnobject(1, DIR_NORTH)
	playse(SE_PIN)
	applymovement(1, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(1, Common_Movement_Delay48)
	waitmovement(0)
	switch(var(VAR_TEMP_1))
	{
		case 10:
			applymovement(1, Route29_Movement_DudeToPlayerTop)
		case 11:
			applymovement(1, Route29_Movement_DudeToPlayerMiddleTop)
		case 12:
			applymovement(1, Route29_Movement_DudeToPlayerMiddleBottom)
		case 13:
			applymovement(1, Route29_Movement_DudeToPlayerBottom)
	}
	waitmovement(1)
	textcolor(MSG_COLOR_BLUE)
	setflag(FLAG_DUDE_TALKED_TO_YOU)
	setvar(VAR_ROUTE29_STATE, 2)
	msgbox(Route29_Text_Dude_TriggerOffer, MSGBOX_YESNO)
	if(!var(VAR_RESULT))
	{
		msgbox(Route29_Text_Dude_CatchingTutRejected)
		closemessage
		switch(var(VAR_TEMP_1))
		{
			case 10:
				applymovement(1, Route29_Movement_DudeFromTop)
			case 11:
				applymovement(1, Route29_Movement_DudeFromMiddleTop)
			case 12:
				applymovement(1, Route29_Movement_DudeFromMiddleBottom)
			case 13:
				applymovement(1, Route29_Movement_DudeFromBottom)
		}
		waitmovement(1)
		releaseall
		end
	}
	closemessage
	switch(var(VAR_TEMP_1))
	{
		case 10:
			applymovement(OBJ_EVENT_ID_PLAYER, Route29_Movement_PlayerFromTop)
			applymovement(1, Route29_Movement_DudeFromTop)
			waitmovement(0)
		case 11:
			applymovement(OBJ_EVENT_ID_PLAYER, Route29_Movement_PlayerFromMiddleTop)
			applymovement(1, Route29_Movement_DudeFromMiddleTop)
			waitmovement(0)
		case 12:
			applymovement(OBJ_EVENT_ID_PLAYER, Route29_Movement_PlayerFromMiddleBottom)
			applymovement(1, Route29_Movement_DudeFromMiddleBottom)
			waitmovement(0)
		case 13:
			applymovement(OBJ_EVENT_ID_PLAYER, Route29_Movement_PlayerFromBottom)
			applymovement(1, Route29_Movement_DudeFromBottom)
			waitmovement(0)
	}
	special(StartDudeTutorialBattle)
	waitstate
	turnobject(1, DIR_NORTH)
	msgbox(Route29_Text_Dude_CatchingOutro)
	setflag(FLAG_LEARNED_TO_CATCH_POKEMON)
	releaseall
	end
}

// ---------------------------------------------------------------------------
// Texts
// ---------------------------------------------------------------------------

text Route29_Text_Tuscany_FirstMeeting {
	poryswitch(LANGUAGE) {
		SPANISH: "MARTA: Creo que es la primera vez\nque nos vemos, ¿verdad?\pPermíteme presentarme.\pSoy MARTA, la del MARTES.\pComo muestra de bienvenida, acepta\neste regalo: un LAZO ROSA."
		_: "TUSCANY: I do believe that this\nis the first time we've met?\pPlease allow me to introduce\nmyself.\pI am TUSCANY of TUESDAY.\pBy way of introduction, please\naccept this gift, a SILK SCARF."
	}
}

text Route29_Text_Tuscany_GiftIntro {
	poryswitch(LANGUAGE) {
		SPANISH: "MARTA: Como muestra de bienvenida,\nacepta este regalo: un\lLAZO ROSA."
		_: "TUSCANY: By way of introduction,\nplease accept this gift, a\lSILK SCARF."
	}
}

text Route29_Text_Tuscany_AfterGift {
	poryswitch(LANGUAGE) {
		SPANISH: "MARTA: ¿No te parece adorable?\pPotencia los movimientos de tipo\nNORMAL. Seguro que te será útil."
		_: "TUSCANY: Wouldn't you agree that\nit is most adorable?\pIt strengthens NORMAL-type moves.\nI am certain it will be of use."
	}
}

text Route29_Text_Tuscany_NotTuesday {
	poryswitch(LANGUAGE) {
		SPANISH: "MARTA: Hoy no es MARTES.\nQué lástima…"
		_: "TUSCANY: Today is not TUESDAY.\nThat is unfortunate…"
	}
}

text Route29_Text_Tuscany_AlreadyReceived {
	poryswitch(LANGUAGE) {
		SPANISH: "MARTA: ¿Conoces a LUNA,\nmi hermana mayor?\l¿O a mi hermano pequeño, MIGUEL?\pSoy la segunda de siete hermanos."
		_: "TUSCANY: Have you met MONICA,\nmy older sister?\lOr my younger brother, WESLEY?\pI am the second of seven children."
	}
}

text Route29_Text_Youngster {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Cómo están tus {POKEMON}?\nSi están débiles y no pueden luchar,\lno entres en la hierba."
		_: "Yo.\nHow are your {POKEMON}?\pIf they're weak and not ready for\nbattle, keep out of the grass."
	}
}

text Route29_Text_LedgeGirl {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Ves esos setos?\nDa miedo saltarlos.\pPero puedes ir a PUEBLO PRIMAVERA\nsin pasar por la hierba."
		_: "See those ledges?\nIt's scary to jump off them.\pBut you can go to NEW BARK without\nwalking through the grass."
	}
}

text Route29_Text_FatMan {
	poryswitch(LANGUAGE) {
		SPANISH: "Quería descansar un poco, así que\nguardé la partida."
		_: "I wanted to take a break, so I\nsaved to record my progress."
	}
}

text Route29_Text_WaitingMan_MorningSuffix {
	poryswitch(LANGUAGE) {
		SPANISH: " por la mañana."
		_: " in the morning."
	}
}

text Route29_Text_WaitingMan_NightSuffix {
	poryswitch(LANGUAGE) {
		SPANISH: " por la noche."
		_: " at night."
	}
}

text Route29_Text_WaitingMan {
	poryswitch(LANGUAGE) {
		SPANISH: "Estoy esperando a los {POKEMON} que\naparecen sólo{STR_VAR_1}"
		_: "I'm waiting for {POKEMON} that appear\nonly{STR_VAR_1}"
	}
}

text Route29_Text_DirectionSign {
	poryswitch(LANGUAGE) {
		SPANISH: "RUTA 29\nCIUDAD CEREZO - PUEBLO PRIMAVERA"
		_: "ROUTE 29\nCHERRYGROVE CITY - NEW BARK TOWN"
	}
}

text Route29_Text_Dude_PokemonInGrass {
	poryswitch(LANGUAGE) {
		SPANISH: "Los {POKEMON} se esconden en la hierba.\nNadie sabe cuándo salen…"
		_: "{POKEMON} hide in the grass.\nWho knows when they'll pop out…"
	}
}

text Route29_Text_Dude_OfferTutorial {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Eh? ¿Quieres que te enseñe\na capturar {POKEMON}?"
		_: "Huh? You want me to show you how\nto catch {POKEMON}?"
	}
}

text Route29_Text_Dude_TriggerOffer {
	poryswitch(LANGUAGE) {
		SPANISH: "Te he visto varias veces.\n¿Cuántos {POKEMON} has capturado?\p¿Quieres que te enseñe\na capturar {POKEMON}?"
		_: "I've seen you a couple times.\nHow many {POKEMON} have you caught?\pWould you like me to show you how\nto catch {POKEMON}?"
	}
}

text Route29_Text_Dude_CatchingTutRejected {
	poryswitch(LANGUAGE) {
		SPANISH: "Oh.\nVale, entonces.\pDe todos modos, si quieres capturar\n{POKEMON}, tendrás que andar mucho."
		_: "Oh.\nFine, then.\pAnyway, if you want to catch\n{POKEMON}, you have to walk a lot."
	}
}

text Route29_Text_Dude_CatchingOutro {
	poryswitch(LANGUAGE) {
		SPANISH: "Así se hace.\pSi los debilitas antes, los {POKEMON}\nserán más fáciles de capturar."
		_: "That's how you do it.\pIf you weaken them first, {POKEMON}\nare easier to catch."
	}
}

// ---------------------------------------------------------------------------
// Movements
// ---------------------------------------------------------------------------

movement(local) Route29_Movement_DudeToPlayerTop{
	walk_up * 5
	walk_right * 2
}movement(local) Route29_Movement_DudeToPlayerMiddleTop{
	walk_up * 4
	walk_right * 2
}movement(local) Route29_Movement_DudeToPlayerMiddleBottom{
	walk_up * 3
	walk_right * 2
}movement(local) Route29_Movement_DudeToPlayerBottom{
	walk_up * 2
	walk_right * 2
}movement(local) Route29_Movement_DudeFromTop{
	walk_left * 2
	walk_down * 5
}movement(local) Route29_Movement_DudeFromMiddleTop{
	walk_left * 2
	walk_down * 4
}movement(local) Route29_Movement_DudeFromMiddleBottom{
	walk_left * 2
	walk_down * 3
}movement(local) Route29_Movement_DudeFromBottom{
	walk_left * 2
	walk_down * 2
}movement(local) Route29_Movement_PlayerFromTop{
	walk_left * 3
	walk_down * 4
}movement(local) Route29_Movement_PlayerFromMiddleTop{
	walk_left * 3
	walk_down * 3
}movement(local) Route29_Movement_PlayerFromMiddleBottom{
	walk_left * 3
	walk_down * 2
}movement(local) Route29_Movement_PlayerFromBottom{
	walk_left * 3
	walk_down
}
