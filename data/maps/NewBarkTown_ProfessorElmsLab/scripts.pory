const OBJ_EVENT_ID_AIDE = 1
const OBJ_EVENT_ID_ELM = 2
const OBJ_EVENT_ID_OFFICER = 3
const PLAYER_STARTER_NUM = VAR_TEMP_1
const PLAYER_STARTER_SPECIES = VAR_TEMP_2

mapscripts NewBarkTown_ProfessorElmsLab_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_ELM_LAB_STATE) == 0)
        {
            setobjectxyperm(OBJ_EVENT_ID_ELM, 4, 5)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ELM_LAB_STATE, 0 : NewBarkTown_ProfessorElmsLab_EventScript_ElmIntroduction
    ]
}

script NewBarkTown_ProfessorElmsLab_EventScript_Elm {
    lock
    faceplayer
    checkitem(ITEM_SS_TICKET, 1)
    if(var(VAR_RESULT))
    {
        call(NewBarkTown_ProfessorElmsLab_EventScript_Elm_CheckMasterBall)
    }
    checkitem(ITEM_SS_TICKET, 1)
    if(flag(FLAG_SYS_GAME_CLEAR) && !var(VAR_RESULT))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: ¡{PLAYER}!\n¡Ahí estás!\pTe llamé porque tengo algo\npara ti.\p¿Ves? Es un TICKET S.S.\nAhora puedes atrapar {POKEMON} en KANTO.", MSGBOX_DEFAULT)
        	_: msgbox("ELM: {PLAYER}!\nThere you are!\pI called because I have something\nfor you.\pSee? It's an S.S. TICKET.\nNow you can catch {POKEMON} in KANTO.", MSGBOX_DEFAULT)
        }
        giveitem(ITEM_SS_TICKET, 1)
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("El barco sale de CIUDAD OLIVO.\nPero ya lo sabías,\l{PLAYER}.\pDespués de todo, has viajado por\ntodo el mundo con tus {POKEMON}.\p¡Saluda de mi parte al PROF. OAK\nen KANTO!", MSGBOX_DEFAULT)
        	_: msgbox("The ship departs from OLIVINE CITY.\nBut you knew that already,\l{PLAYER}.\pAfter all, you've traveled all over\nwith your {POKEMON}.\pGive my regards to PROF. OAK\nin KANTO!", MSGBOX_DEFAULT)
        }
        closemessage
        release
        end
    }
    call(NewBarkTown_ProfessorElmsLab_EventScript_Elm_CheckMasterBall)
    if (flag(FLAG_GOT_EVERSTONE_FROM_ELM))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: {PLAYER}, te llamaré si\nsurge algo.")
        	_: msgbox("ELM: {PLAYER}, I'll call you if\n"
                   "anything comes up.")
        }
    }
    elif (flag(FLAG_SHOWED_TOGEPI_TO_ELM))
    {
        call(NewBarkTown_ProfessorElmsLab_EventScript_Elm_GiveEverstone)
    }
    elif (flag(FLAG_GOT_ELMS_EGG))
    {
        if (!flag(FLAG_HATCHED_ELMS_EGG))
        {
            msgbox(NewBarkTown_ProfessorElmsLab_Text_Elm_HasThatEggHatched)
        }
        else
        {
            setvar(VAR_0x8004, SPECIES_TOGEPI)
            special(IsPlayersMonOfSpeciesInParty)
            if (!var(VAR_RESULT))
            {
                setvar(VAR_0x8004, SPECIES_TOGETIC)
                special(IsPlayersMonOfSpeciesInParty)
                if (!var(VAR_RESULT))
                {
                    goto(NewBarkTown_ProfessorElmsLab_EventScript_Elm_NoHatchedEggMon)
                }
            }
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("ELM: {PLAYER}, ¡estás genial!")
            	_: msgbox("ELM: {PLAYER}, you look great!")
            }
            closemessage
            playse(SE_PIN)
            applymovement(OBJ_EVENT_ID_ELM, Common_Movement_ExclamationMark)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_ELM, Common_Movement_Delay48)
            waitmovement(0)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("¿Qué? ¿Ese {POKEMON}!?\n¡Ha eclosionado el HUEVO!\pEntonces, los {POKEMON} nacen de\nHUEVOS…\pNo, quizá no todos los {POKEMON}.\pVaya, aún queda mucha\ninvestigación por hacer.\p", MSGBOX_CONTINUE)
            	_: msgbox("What? That {POKEMON}!?!\n"
                       "The EGG hatched!\p"
                       "So, {POKEMON} are born from EGGS…\n"
                       "No, perhaps not all {POKEMON} are.\p"
                       "Wow, there's still a lot of research\n"
                       "to be done.\p", MSGBOX_CONTINUE)
            }
            setflag(FLAG_SHOWED_TOGEPI_TO_ELM)
            call(NewBarkTown_ProfessorElmsLab_EventScript_Elm_GiveEverstone)
        }
    }
    elif (flag(FLAG_ELM_CALLED_ABOUT_ASSISTANT_IN_VIOLET))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: ¿{PLAYER}?\n¿No te encontraste con mi ayudante?\pDebería haberte esperado con el HUEVO\nen el CENTRO {POKEMON} de CIUDAD MALVA.\pSeguro que no os cruzasteis.\nIntenta encontrarlo allí.")
        	_: msgbox("ELM: {PLAYER}?\n"
                   "Didn't you meet my assistant?\p"
                   "He should have met you with the EGG\n"
                   "at VIOLET CITY's {POKEMON} CENTER.\p"
                   "You must have just missed him.\n"
                   "Try to catch him there.")
        }
    }
    elif (flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: ¡No te rindas! Te llamaré si\naprendo algo sobre ese HUEVO!")
        	_: msgbox("ELM: Don't give up! I'll call if I\n"
                   "learn anything about that EGG!")
        }
    }
    elif (flag(FLAG_RECEIVED_MYSTERY_EGG))
    {
        msgbox(
            poryswitch(LANGUAGE) {
                SPANISH: "ELM: {PLAYER}, esto es terrible…\pAh, sí, ¿cuál fue el gran\ndescubrimiento del SR. {POKEMON}?"
                _: "ELM: {PLAYER}, this is terrible…\p"
                   "Oh, yes, what was MR. {POKEMON}'s big\n"
                   "discovery?"
        )
        textcolor(MSG_COLOR_SYS)
        playfanfare(MUS_OBTAIN_ITEM)
                poryswitch(LANGUAGE) {
        	SPANISH: message("{PLAYER} le entregó el HUEVO\nMISTERIOSO al PROF. ELM.")
        	_: message("{PLAYER} handed the MYSTERY EGG to\n"
                   "PROF. ELM.")
        }
        waitmessage
        waitfanfare
        closemessage
        textcolor(MSG_COLOR_PREV)
        removeitem(ITEM_MYSTERY_EGG)
        delay(10)
        switch (var(VAR_FACING))
        {
            case DIR_SOUTH:
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsDown)
                waitmovement(0)
                msgbox(NewBarkTown_ProfessorElmsLab_Text_ElmThis)
                closemessage
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmStepsUp)
                waitmovement(0)
            case DIR_NORTH:
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsUp)
                waitmovement(0)
                msgbox(NewBarkTown_ProfessorElmsLab_Text_ElmThis)
                closemessage
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmStepsDown)
                waitmovement(0)
            case DIR_WEST:
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsLeft)
                waitmovement(0)
                msgbox(NewBarkTown_ProfessorElmsLab_Text_ElmThis)
                closemessage
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmStepsRight)
                waitmovement(0)
            case DIR_EAST:
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsRight)
                waitmovement(0)
                msgbox(NewBarkTown_ProfessorElmsLab_Text_ElmThis)
                closemessage
                applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmStepsLeft)
                waitmovement(0)
        }
        msgbox(
            poryswitch(LANGUAGE) {
                SPANISH: "Pero… ¿Es un HUEVO {POKEMON}?\n¡Si lo es, es un gran descubrimiento!\p¿Qué?!?\n¿El PROF. OAK te dio una {POKEDEX}?\p¿{PLAYER}, es verdad?\n¡E-es increíble!\pEs un genio viendo el potencial\nde la gente como ENTRENADORES.\pVaya, {PLAYER}. Quizá tengas lo\nnecesario para ser CAMPEÓN.\pParece que te llevas genial con\nlos {POKEMON} también.\pDeberías aceptar el desafío del\nGIMNASIO {POKEMON}.\pEl GIMNASIO más cercano sería el de\nCIUDAD MALVA.\p…{PLAYER}. El camino al\ncampeonato será largo.\pAntes de irte, asegúrate de\nhablar con tu mamá."
                _: "But… Is it a {POKEMON} EGG?\n"
                   "If it is, it's a great discovery!\p"
                   "What?!?\n"
                   "PROF. OAK gave you a {POKEDEX}?\p"
                   "{PLAYER}, is that true?\n"
                   "Th-that's incredible!\p"
                   "He is superb at seeing the potential\n"
                   "of people as TRAINERS.\p"
                   "Wow, {PLAYER}. You may have what it\n"
                   "takes to become the CHAMPION.\p"
                   "You seem to be getting on great with\n"
                   "{POKEMON} too.\p"
                   "You should take the {POKEMON} GYM\n"
                   "challenge.\p"
                   "The closest GYM would be the one in\n"
                   "VIOLET CITY.\p"
                   "…{PLAYER}. The road to the\n"
                   "championship will be a long one.\p"
                   "Before you leave, make sure that\n"
                   "you talk to your mom."
        )
        setflag(FLAG_ADVENTURE_STARTED)
        setflag(FLAG_GAVE_MYSTERY_EGG_TO_ELM)
        setflag(FLAG_HIDE_ROUTE_30_YOUNGSTER_BATTLE_OBJECTS)
        clearflag(FLAG_HIDE_ROUTE_30_YOUNGSTER_DEFEATED)
        setvar(VAR_ROUTE29_STATE, 1)
        setvar(VAR_ELM_LAB_STATE, 6)
        setvar(VAR_CABLE_CLUB_TUTORIAL_STATE, 1)
    }
    elif (flag(FLAG_SYS_POKEMON_GET))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: El SR. {POKEMON} va a todas\npartes y encuentra rarezas.\pLástima que sean solo raras y\nno muy útiles…")
        	_: msgbox("ELM: MR. {POKEMON} goes everywhere\n"
                   "and finds rarities.\p"
                   "Too bad they're just rare and\n"
                   "not very useful…")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: Si aparece un {POKEMON} salvaje,\n¡haz que tu {POKEMON} luche contra él!")
        	_: msgbox("ELM: If a wild {POKEMON} appears,\n"
                   "let your {POKEMON} battle it!")
        }
    }
    release
}

text NewBarkTown_ProfessorElmsLab_Text_ElmThis {
    poryswitch(LANGUAGE) {
        SPANISH: "ELM: ¿Esto?"
        _: "ELM: This?"
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_Elm_CheckMasterBall {
    if(flag(FLAG_GOT_MASTER_BALL_FROM_ELM) || !flag(FLAG_BADGE08_GET))
    {
        return
    }
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("ELM: ¡Hola, {PLAYER}!\pGracias a ti, mi investigación\nva de maravilla!\pToma esto como muestra de\nmi agradecimiento.", MSGBOX_DEFAULT)
    	_: msgbox("ELM: Hi, {PLAYER}!\pThanks to you, my research is\ngoing great!\pTake this as a token of my\nappreciation.", MSGBOX_DEFAULT)
    }
    checkitemspace(ITEM_MASTER_BALL, 1)
    if(!var(VAR_RESULT))
    {
        call(Common_EventScript_BagIsFull)
        release
        end
    }
    giveitem(ITEM_MASTER_BALL, 1)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡La MASTER BALL es la mejor!\n¡Es la BALL definitiva!\pAtrapa a cualquier {POKEMON} sin\nfallar.\pSolo se entrega a investigadores\n{POKEMON} reconocidos.\pCreo que le sacarás mucho más\npartido que yo, {PLAYER}!", MSGBOX_DEFAULT)
    	_: msgbox("The MASTER BALL is the best!\nIt's the ultimate BALL!\pIt'll catch any {POKEMON} without\nfail.\pIt's given only to recognized {POKEMON}\nresearchers.\pI think you can make much better\nuse of it than I can, {PLAYER}!", MSGBOX_DEFAULT)
    }
    setflag(FLAG_GOT_MASTER_BALL_FROM_ELM)
    release
    end
}

script NewBarkTown_ProfessorElmsLab_EventScript_Elm_NoHatchedEggMon {
    if (flag(FLAG_CALLED_ELM_ABOUT_HATCHED_EGG))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("ELM: ¿{PLAYER}?\nCreía que el HUEVO había eclosionado.\l¿Dónde está el {POKEMON}?")
        	_: msgbox("ELM: {PLAYER}?\n"
                    "I thought the EGG hatched.\l"
                    "Where is the {POKEMON}?")
        }
    }
    else
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Elm_HasThatEggHatched)
    }
    release
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_HasThatEggHatched {
    poryswitch(LANGUAGE) {
        SPANISH: "ELM: Oye, ¿ha cambiado algo ese HUEVO?"
        _: "ELM: Hey, has that EGG changed any?"
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_Elm_GiveEverstone {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡Gracias, {PLAYER}! ¡Nos ayudas a\ndesvelar los misterios de los {POKEMON}!\pQuiero que aceptes esto como\nmuestra de nuestro agradecimiento.")
    	_: msgbox("Thanks, {PLAYER}! You're helping\n"
               "unravel {POKEMON} mysteries for us!\p"
               "I want you to have this as a token\n"
               "of our appreciation.")
    }
    checkitemspace(ITEM_EVERSTONE, 1)
    if (!var(VAR_RESULT))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿Eh? No tienes sitio para\nla PIEDRA ETERNA…")
        	_: msgbox("Oh? You don't have any room\n"
                   "for the EVERSTONE…")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: giveitem_msg("{PLAYER} recibió la PIEDRA\nETERNA del PROF. ELM.", ITEM_EVERSTONE)
        	_: giveitem_msg("{PLAYER} received the EVERSTONE\n"
                   "from PROF. ELM.", ITEM_EVERSTONE)
        }
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Esa es una PIEDRA ETERNA.\pAlgunas especies de {POKEMON} evolucionan\nal alcanzar ciertos niveles.\pUn {POKEMON} que lleve la PIEDRA\nETERNA no evolucionará.\pDásela a un {POKEMON} que no\nquieras que evolucione.")
        	_: msgbox("That's an EVERSTONE.\p"
                   "Some species of {POKEMON} evolve\n"
                   "when they grow to certain levels.\p"
                   "A {POKEMON} holding the EVERSTONE\n"
                   "won't evolve.\p"
                   "Give it to a {POKEMON} you don't want\n"
                   "to evolve.")
        }
        setflag(FLAG_GOT_EVERSTONE_FROM_ELM)
    }
    release
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsDown {
	lock_facing_direction
	walk_down
	unlock_facing_direction
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmStepsUp {
	walk_up
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsUp {
	lock_facing_direction
	walk_up
	unlock_facing_direction
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmStepsDown {
	walk_down
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsLeft {
	lock_facing_direction
	walk_left
	unlock_facing_direction
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmStepsRight {
	walk_right
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmJumpsRight {
	lock_facing_direction
	walk_right
	unlock_facing_direction
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmStepsLeft {
	walk_left
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmIntroduction {
    lockall
    textcolor(MSG_COLOR_BLUE)
    applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_PlayerStepToElm)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestRight)
    waitmovement(0)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("ELM: ¡{PLAYER}!\n¡Aquí estás!\l¡Tenía que pedirte un favor!\pEstoy investigando {POKEMON}\nahora mismo, y me preguntaba si\lpodrías ayudarme, {PLAYER}.\pVerás…\pEstoy escribiendo un artículo que\nquiero presentar en un congreso.\pPero hay cosas que aún no\nentiendo del todo.\p¡Así que! Me gustaría que criaras\nun {POKEMON} que capturé hace poco.", MSGBOX_YESNO)
    	_: msgbox("ELM: {PLAYER}!\n"
               "There you are!\l"
               "I needed to ask you a favor.\p"
               "I'm conducting {POKEMON} research\n"
               "right now, and I was wondering if\l"
               "you could help me with it, {PLAYER}.\p"
               "You see…\p"
               "I'm writing a paper that I want to\n"
               "present at a conference.\p"
               "But there are some things I don't\n"
               "quite understand yet.\p"
               "So! I'd like you to raise a {POKEMON}\n"
               "that I recently caught.", MSGBOX_YESNO)
    }
    goto(NewBarkTown_ProfessorElmsLab_EventScript_ElmBeggingLoop)
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmBeggingLoop {
    if (var(VAR_RESULT) == YES)
    {
        goto(NewBarkTown_ProfessorElmsLab_EventScript_ElmPostBegging)
    }
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Pero…\n¡Por favor, necesito tu ayuda!", MSGBOX_YESNO)
    	_: msgbox("But…\n"
	       "Please, I need your help!", MSGBOX_YESNO)
    }
    goto(NewBarkTown_ProfessorElmsLab_EventScript_ElmBeggingLoop)
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmPostBegging {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡Gracias, {PLAYER}!\n¡Eres de gran ayuda!\pCuando anuncie mis hallazgos,\nseguro que profundizaremos un poco\lmás en los misterios de los {POKEMON}.\p¡Puedes contar con ello!")
    	_: msgbox("Thanks, {PLAYER}!\n"
               "You're a great help!\p"
               "When I announce my findings, I'm\n"
               "sure we'll delve a bit deeper into\l"
               "the many mysteries of {POKEMON}.\p"
               "You can count on it!")
    }
    closemessage
    delay(20)
    playse(SE_SUCCESS)
    waitse
    delay(20)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestDown)
    waitmovement(0)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡Oh, vaya!\n¡Tengo un e-mail!\p………………\nHm… Ajá…\lVale…")
    	_: msgbox("Oh, hey!\n"
               "I got an e-mail!\p"
               "………………\n"
               "Hm… Uh-huh…\l"
               "Okay…")
    }
    closemessage
    delay(30)
    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestRight)
    waitmovement(0)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Eh, escucha.\pConozco a alguien llamado\nSR. {POKEMON}.\pSiempre encuentra cosas raras y\nhabla emocionado de sus descubrimientos.\pDe todos modos, acabo de recibir\nun e-mail suyo diciendo que esta vez es real.\pEs intrigante, pero estamos ocupados\ncon nuestra investigación {POKEMON}…\p¡Espera!\n¡Ya sé!\p{PLAYER}, ¿puedes ir en nuestro lugar?")
    	_: msgbox("Hey, listen.\p"
               "I have an acquaintance called\n"
               "MR. {POKEMON}.\p"
               "He keeps finding weird things and\n"
               "raving about his discoveries.\p"
               "Anyway, I just got an e-mail from\n"
               "him saying that this time it's real.\p"
               "It is intriguing, but we're busy with\n"
               "our {POKEMON} research…\p"
               "Wait!\n"
               "I know!\p"
               "{PLAYER}, can you go in our place?")
    }
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_PlayerWatchElmWalk)
    applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_ElmWalkToPokeBalls)
    waitmovement(0)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Quiero que cuides de uno de los\n{POKEMON} de estas\l{POKE} BALLS.\p¡Serás el primer compañero de\nese {POKEMON}, {PLAYER}!\pVenga.\n¡Elige uno!")
    	_: msgbox("I want you to raise one of the\n"
               "{POKEMON} contained in these\l"
               "{POKE} BALLS.\p"
               "You'll be that {POKEMON}'s first\n"
               "partner, {PLAYER}!\p"
               "Go on, then.\n"
               "Pick one!")
    }
    closemessage
    setvar(VAR_ELM_LAB_STATE, 1)
    releaseall
}

movement NewBarkTown_ProfessorElmsLab_Movement_PlayerStepToElm {
    walk_up * 7
	walk_left
}

movement NewBarkTown_ProfessorElmsLab_Movement_PlayerWatchElmWalk {
	delay_16
	walk_in_place_fastest_up
	delay_16
	walk_in_place_fastest_right
}

movement NewBarkTown_ProfessorElmsLab_Movement_ElmWalkToPokeBalls {
	walk_up * 2
	walk_right * 2
	face_down
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmWaitDontGo {
    lockall
    textcolor(MSG_COLOR_BLUE)
    turnobject(OBJ_EVENT_ID_ELM, DIR_SOUTH)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("ELM: ¡Espera!\n¿Adónde vas?")
    	_: msgbox("ELM: Wait!\n"
               "Where are you going?")
    }
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_PlayerComeBack)
    waitmovement(0)
    releaseall
}

movement NewBarkTown_ProfessorElmsLab_Movement_PlayerComeBack {
    walk_up
}

script NewBarkTown_ProfessorElmsLab_EventScript_Chikorita {
    lock
    faceplayer
	setvar(PLAYER_STARTER_NUM, STARTER_CHIKORITA)
	setvar(PLAYER_STARTER_SPECIES, SPECIES_CHIKORITA)
    goto(NewBarkTown_EventScript_PokeBallMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_Totodile {
    lock
    faceplayer
	setvar(PLAYER_STARTER_NUM, STARTER_TOTODILE)
	setvar(PLAYER_STARTER_SPECIES, SPECIES_TOTODILE)
    goto(NewBarkTown_EventScript_PokeBallMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_Cyndaquil {
    lock
    faceplayer
	setvar(PLAYER_STARTER_NUM, STARTER_CYNDAQUIL)
	setvar(PLAYER_STARTER_SPECIES, SPECIES_CYNDAQUIL)
    goto(NewBarkTown_EventScript_PokeBallMain)
}

script NewBarkTown_EventScript_PokeBallMain {
    if (flag(FLAG_SYS_POKEMON_GET))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Contiene un {POKEMON} capturado\npor el PROF. ELM.")
        	_: msgbox("It contains a {POKEMON} caught by\n"
                   "PROF. ELM.")
        }
    }
    else
    {
        turnobject(OBJ_EVENT_ID_ELM, DIR_EAST)
        showmonpic(PLAYER_STARTER_SPECIES, 10, 3)
        playmoncry(PLAYER_STARTER_SPECIES, 0)
        textcolor(MSG_COLOR_BLUE)
        switch (var(PLAYER_STARTER_NUM))
        {
            case STARTER_CHIKORITA:
                                poryswitch(LANGUAGE) {
                	SPANISH: msgbox("ELM: ¡Hm! Has elegido CHIKORITA.\nTómate tu tiempo para criarlo.\pEntonces, {PLAYER}, ¿te gusta CHIKORITA,\nel {POKEMON} de tipo PLANTA?", MSGBOX_YESNO)
                	_: msgbox("ELM: Hm! CHIKORITA is your choice.\n"
                           "Take your time raising it.\p"
                           "So, {PLAYER}, do you like CHIKORITA,\n"
                           "the GRASS {POKEMON}?", MSGBOX_YESNO)
                }
            case STARTER_TOTODILE:
                                poryswitch(LANGUAGE) {
                	SPANISH: msgbox("ELM: ¡Ah! Has elegido TOTODILE.\nSerá gratificante criarlo.\pEntonces, {PLAYER}, ¿quieres TOTODILE,\nel {POKEMON} de tipo AGUA?", MSGBOX_YESNO)
                	_: msgbox("ELM: Ah! TOTODILE is your choice.\n"
                           "It would be rewarding to raise.\p"
                           "So, {PLAYER}, do you want TOTODILE,\n"
                           "the WATER {POKEMON}?", MSGBOX_YESNO)
                }
            case STARTER_CYNDAQUIL:
                                poryswitch(LANGUAGE) {
                	SPANISH: msgbox("ELM: ¡Oh! Has elegido CYNDAQUIL.\nSerá fácil criarlo.\pEntonces, {PLAYER}, ¿te quedas con CYNDAQUIL,\nel {POKEMON} de tipo FUEGO?", MSGBOX_YESNO)
                	_: msgbox("ELM: Oh! CYNDAQUIL is your choice.\n"
                           "Raising it would be a cinch.\p"
                           "So, {PLAYER}, you'll take CYNDAQUIL,\n"
                           "the FIRE {POKEMON}?", MSGBOX_YESNO)
                }
        }
        hidemonpic
        if (var(VAR_RESULT) != YES)
        {
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("ELM: Piénsalo con cuidado.\nTu compañero es importante.")
            	_: msgbox("ELM: Think it over carefully.\n"
                       "Your partner is important.")
            }
        }
        else
        {
            removeobject(VAR_LAST_TALKED)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("ELM: ¡Creo que también es un\ngran {POKEMON}!")
            	_: msgbox("ELM: I think that's a great\n"
                       "{POKEMON} too!")
            }
            textcolor(MSG_COLOR_PREV)
            setflag(FLAG_SYS_POKEMON_GET)
            givemon(PLAYER_STARTER_SPECIES, 5, ITEM_ORAN_BERRY)
            copyvar(VAR_STARTER_MON, PLAYER_STARTER_NUM) // 0=Chikorita, 1=Totodile, 2=Cyndaquil
            bufferspeciesname(0, PLAYER_STARTER_SPECIES)
                        poryswitch(LANGUAGE) {
            	SPANISH: message("{PLAYER} recibió el {STR_VAR_1}\ndel PROF. ELM!")
            	_: message("{PLAYER} received the {STR_VAR_1}\n"
                       "from PROF. ELM!")
            }
            waitmessage
            if (flag(FLAG_SYS_GBS_ENABLED))
            {
                playfanfare(MUS_RG_CAUGHT_INTRO)
            }
            else
            {
                playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
            }
            waitfanfare
            msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES)
            {
                setvar(VAR_0x8004, 0)
                call(Common_EventScript_NameReceivedPartyMon)
            }
            closemessage
            switch (var(VAR_FACING))
            {
                case DIR_SOUTH:
                    switch (var(PLAYER_STARTER_NUM))
                    {
                        case STARTER_CHIKORITA:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay32FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom83)
                        case STARTER_TOTODILE:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay48FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom93)
                        case STARTER_CYNDAQUIL:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay64FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom103)
                    }
                case DIR_NORTH:
                    switch (var(PLAYER_STARTER_NUM))
                    {
                        case STARTER_CHIKORITA:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay16FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom85)
                        case STARTER_TOTODILE:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay32FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom95)
                        case STARTER_CYNDAQUIL:
                            applymovement(OBJ_EVENT_ID_ELM, NewBarkTown_ProfessorElmsLab_Movement_Delay48FaceDown)
                            applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom105)
                    }
                case DIR_EAST:
                    applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestDown)
                    applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom74)
            }
            waitmovement(0)
            delay(20)
            textcolor(MSG_COLOR_BLUE)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("El SR. {POKEMON} vive un poco más\nallá de PUEBLO CEREZO.\pEs casi todo recto,\nasí que no te perderás.\pPero por si acaso, aquí tienes mi\nnúmero. ¡Llámame si surge algo!")
            	_: msgbox("MR. {POKEMON} lives a bit beyond\n"
                       "CHERRYGROVE, the next city over.\p"
                       "It's almost a direct route there,\n"
                       "so you can't miss it.\p"
                       "But just in case, here's my number.\n"
                       "Call me if anything comes up!")
            }
            setflag(FLAG_PHONE_CARD_ELM)
            playfanfare(MUS_REGISTER_PHONE)
            textcolor(MSG_COLOR_PREV)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("{PLAYER} obtuvo el número de teléfono\ndel PROF. ELM.")
            	_: msgbox("{PLAYER} got PROF. ELM's phone\n"
                       "number.")
            }
            waitfanfare
            applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestLeft)
            waitmovement(0)
            textcolor(MSG_COLOR_BLUE)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("Si tu {POKEMON} está herido, debes\ncurarlo con esta máquina.\lÚsala cuando quieras.")
            	_: msgbox("If your {POKEMON} is hurt, you should\n"
                       "heal it with this machine.\l"
                       "Feel free to use it anytime.")
            }
            applymovement(OBJ_EVENT_ID_ELM, Common_Movement_WalkInPlaceFastestDown)
            waitmovement(0)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("¡{PLAYER}, cuento contigo!")
            	_: msgbox("{PLAYER}, I'm counting on you!")
            }
            setvar(VAR_ELM_LAB_STATE, 2)
            setvar(VAR_NEW_BARK_TOWN_STATE, 1)
        }
    }
    release
}

