script NewBarkTown_ProfessorElmsLab_EventScript_Officer3 {
    lockall
    setvar(VAR_TEMP_1, 2)
    applymovement(OBJ_EVENT_ID_OFFICER, NewBarkTown_ProfessorElmsLab_Movement_OfficerWaitFaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, NewBarkTown_ProfessorElmsLab_Movement_PlayerToOfficerFromRight)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_OfficerMain)
}

movement NewBarkTown_ProfessorElmsLab_Movement_OfficerWaitFaceRight {
	delay_16 * 3
	walk_in_place_fastest_right
}

movement NewBarkTown_ProfessorElmsLab_Movement_PlayerToOfficerFromRight {
	walk_up * 3
	face_left
}

script NewBarkTown_ProfessorElmsLab_EventScript_OfficerMain {
    waitmovement(0)
    textcolor(MSG_COLOR_BLUE)
    msgbox(NewBarkTown_ProfessorElmsLab_Text_OfficerMain_IHeardAPokemon)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival)
}

script NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival {
    fadescreen(FADE_TO_BLACK)
    special(SetRivalNickname)
    waitstate
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Officer_NameRival_LetMeMakeSure, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival)
    }
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Officer_NameRival_OkaySoRIVALWas)
    closemessage
    applymovement(OBJ_EVENT_ID_OFFICER, NewBarkTown_ProfessorElmsLab_Movement_OfficerLeaves)
    waitmovement(0)
    removeobject(OBJ_EVENT_ID_OFFICER)
    setvar(VAR_ELM_LAB_STATE, 5)
    releaseall
}

movement NewBarkTown_ProfessorElmsLab_Movement_OfficerLeaves {
    walk_down * 6
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls1 {
    lockall
    setvar(VAR_TEMP_1, 0)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToLeftTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls2 {
    lockall
    setvar(VAR_TEMP_1, 1)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToMiddleTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls3 {
    lockall
    setvar(VAR_TEMP_1, 2)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToRightTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain {
    waitmovement(0)
    textcolor(MSG_COLOR_BLUE)
    msgbox(NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_UseTheseOnYour)
    giveitem_msg(NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_ReceivedThePOKEBALLS, ITEM_POKE_BALL, 5)
    msgbox(NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_ToAddToYour)
    closemessage
    switch (var(VAR_TEMP_1))
    {
        case 0:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromLeftTrigger)
        case 1:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromMiddleTrigger)
        case 2:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromRightTrigger)
    }
    waitmovement(0)
    setvar(VAR_ELM_LAB_STATE, 7)
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_Aide {
    lock
    faceplayer
    if (flag(FLAG_GOT_ELMS_EGG))
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Aide_SighThatStolen)
    }
    elif (flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Aide_ToAddToYour)
    }
    elif (flag(FLAG_RECEIVED_MYSTERY_EGG))
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Aide_ThereWasALoud)
    }
    else
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Aide_AlwaysBusy)
    }
    release
}

script NewBarkTown_ProfessorElmsLab_EventScript_OpenWindow {
    if (flag(FLAG_VISITED_VIOLET_CITY) || !flag(FLAG_ELM_CALLED_ABOUT_STOLEN_MON))
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_OpenWindow_TheWindowIsOpen, MSGBOX_SIGN)
    }
    else
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_OpenWindow_HeMustVeBroken, MSGBOX_SIGN)
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_HealingMachine {
    lockall
    if (!flag(FLAG_SYS_POKEMON_GET))
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_HealingMachine_WonderWhatThisMachine)
    }
    else
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_HealingMachine_WouldYouLikeTo, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            closemessage
            delay(24)
            dofieldeffect(FLDEFF_POKECENTER_HEAL)
            waitfieldeffect(FLDEFF_POKECENTER_HEAL)
            special(HealPlayerParty)
        }
    }
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmsPC {
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ElmsPC_OBSERVATIONSONPokemon, MSGBOX_SIGN)
}

script NewBarkTown_ProfessorElmsLab_EventScript_TrashCan {
    msgbox(NewBarkTown_ProfessorElmsLab_Text_TrashCan_TheWrapperFromThe, MSGBOX_SIGN)
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf1 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Shelf1_TravelTip1Press)
    normalmsg
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf2 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Shelf2_TravelTip2Record)
    normalmsg
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf3 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Shelf3_TravelTip3Open)
    normalmsg
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf4 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
    msgbox(NewBarkTown_ProfessorElmsLab_Text_Shelf4_TravelTip4Check)
    normalmsg
    releaseall
}

// ---------------------------------------------------------------------------
// Texts
// ---------------------------------------------------------------------------

text NewBarkTown_ProfessorElmsLab_Text_ElmThis {
    poryswitch(LANGUAGE) {
        SPANISH: "ELM: ¿Esto?"
        _: "ELM: This?"
    }
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_HasThatEggHatched {
    poryswitch(LANGUAGE) {
        SPANISH: "ELM: Oye, ¿ha cambiado algo ese HUEVO?"
        _: "ELM: Hey, has that EGG changed any?"
    }
}

text NewBarkTown_ProfessorElmsLab_Text_Aide_AlwaysBusy {
    poryswitch(LANGUAGE) {
        SPANISH: "Solo somos dos, así que siempre\nestamos ocupados."
        _: "There are only two of us, so we're\n"
           "always busy."
    }
}

text NewBarkTown_ProfessorElmsLab_Text_ShelfIntro {
    poryswitch(LANGUAGE) {
        SPANISH: "{PLAYER} abrió un libro."
        _: "{PLAYER} opened a book."
    }
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMThereYouAre {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡{PLAYER}!\n¡Ahí estás!\pTe llamé porque tengo algo\npara ti.\p¿Ves? Es un TICKET S.S.\nAhora puedes atrapar {POKEMON} en KANTO."
		_: "ELM: {PLAYER}!\nThere you are!\pI called because I have something\nfor you.\pSee? It's an S.S. TICKET.\nNow you can catch {POKEMON} in KANTO."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_TheShipDepartsFrom {
	poryswitch(LANGUAGE) {
		SPANISH: "El barco sale de CIUDAD OLIVO.\nPero ya lo sabías,\l{PLAYER}.\pDespués de todo, has viajado por\ntodo el mundo con tus {POKEMON}.\p¡Saluda de mi parte al PROF. OAK\nen KANTO!"
		_: "The ship departs from OLIVINE CITY.\nBut you knew that already,\l{PLAYER}.\pAfter all, you've traveled all over\nwith your {POKEMON}.\pGive my regards to PROF. OAK\nin KANTO!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMILlCall {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: {PLAYER}, te llamaré si\nsurge algo."
		_: "ELM: {PLAYER}, I'll call you if\n"
                   "anything comes up."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMYouLookGreat {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: {PLAYER}, ¡estás genial!"
		_: "ELM: {PLAYER}, you look great!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_WhatThatPokemonThe {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Qué? ¿Ese {POKEMON}!?\n¡Ha eclosionado el HUEVO!\pEntonces, los {POKEMON} nacen de\nHUEVOS…\pNo, quizá no todos los {POKEMON}.\pVaya, aún queda mucha\ninvestigación por hacer.\p"
		_: "What? That {POKEMON}!?!\n"
                   "The EGG hatched!\p"
                   "So, {POKEMON} are born from EGGS…\n"
                   "No, perhaps not all {POKEMON} are.\p"
                   "Wow, there's still a lot of research\n"
                   "to be done.\p"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMDidnTYou {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¿{PLAYER}?\n¿No te encontraste con mi ayudante?\pDebería haberte esperado con el HUEVO\nen el CENTRO {POKEMON} de CIUDAD MALVA.\pSeguro que no os cruzasteis.\nIntenta encontrarlo allí."
		_: "ELM: {PLAYER}?\n"
                   "Didn't you meet my assistant?\p"
                   "He should have met you with the EGG\n"
                   "at VIOLET CITY's {POKEMON} CENTER.\p"
                   "You must have just missed him.\n"
                   "Try to catch him there."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMDonTGive {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡No te rindas! Si averiguo\nalgo sobre ese HUEVO, te llamaré."
		_: "ELM: Don't give up! I'll call if I\n"
                   "learn anything about that EGG!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMThisIsTerrible {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: {PLAYER}, esto es terrible…\pOh, sí, ¿cuál era el gran\ndescubrimiento del SR. {POKEMON}?"
		_: "ELM: {PLAYER}, this is terrible…\p"
                   "Oh, yes, what was MR. {POKEMON}'s big\n"
                   "discovery?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_HandedTheMYSTERYEGG {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} le entregó el HUEVO\nMISTERIOSO al PROF. ELM."
		_: "{PLAYER} handed the MYSTERY EGG to\n"
                   "PROF. ELM."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ButIsItA {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¿Esto?\pPero… ¿Es un HUEVO {POKEMON}?\nSi lo es, ¡vaya descubrimiento!\p¿Qué?!?\n¿El PROF. OAK te dio una {POKEDEX}?\p¿{PLAYER}, es cierto?\nEs… ¡Es increíble!\pÉl es capaz de ver el potencial\nde un ENTRENADOR sólo con mirarle.\pUau, {PLAYER}. Parece que tienes\nlo que hay que tener.\pY parece que te llevas muy bien\ncon los {POKEMON}.\pDeberías afrontar el reto de los\nGIMNASIOS {POKEMON}.\pEl GIMNASIO más cercano es el de\nCIUDAD MALVA.\p{PLAYER}… El camino hacia el\ncampeonato será largo.\pAntes de partir, no te\nolvides de ver a tu madre."
		_: "But… Is it a {POKEMON} EGG?\n"
                   "If it is, it's a great discovery!\p"
                   "What?!?\n"
                   "PROF. OAK gave you a {POKEDEX}?\p"
                   "{PLAYER}, is that true?\n"
                   "Th-that's incredible!\p"
                   "He is superb at seeing the potential\n"
                   "of people as TRAINERS.\p"
                   "Wow, {PLAYER}. You may have what it\n"
                   "takes to become the CHAMPION.\p"
                   "You seem to be getting on great with\n"
                   "{POKEMON} too.\p"
                   "You should take the {POKEMON} GYM\n"
                   "challenge.\p"
                   "The closest GYM would be the one in\n"
                   "VIOLET CITY.\p"
                   "…{PLAYER}. The road to the\n"
                   "championship will be a long one.\p"
                   "Before you leave, make sure that\n"
                   "you talk to your mom."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMMRPokemonGoes {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: El SR. {POKEMON} va a todas\npartes y encuentra rarezas.\pLástima que sean solo raras y\nno muy útiles…"
		_: "ELM: MR. {POKEMON} goes everywhere\n"
                   "and finds rarities.\p"
                   "Too bad they're just rare and\n"
                   "not very useful…"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_ELMIfAWild {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: Si aparece un {POKEMON} salvaje,\n¡haz que tu {POKEMON} luche contra él!"
		_: "ELM: If a wild {POKEMON} appears,\n"
                   "let your {POKEMON} battle it!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_CheckMasterBall_ELMHiPThanksTo {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Hola, {PLAYER}!\pGracias a ti, mi investigación\nva de maravilla!\pToma esto como muestra de\nmi agradecimiento."
		_: "ELM: Hi, {PLAYER}!\pThanks to you, my research is\ngoing great!\pTake this as a token of my\nappreciation."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_CheckMasterBall_TheMASTERBALLIs {
	poryswitch(LANGUAGE) {
		SPANISH: "¡La MASTER BALL es la mejor!\n¡Es la BALL definitiva!\pAtrapa a cualquier {POKEMON} sin\nfallar.\pSolo se entrega a investigadores\n{POKEMON} reconocidos.\pCreo que le sacarás mucho más\npartido que yo, {PLAYER}!"
		_: "The MASTER BALL is the best!\nIt's the ultimate BALL!\pIt'll catch any {POKEMON} without\nfail.\pIt's given only to recognized {POKEMON}\nresearchers.\pI think you can make much better\nuse of it than I can, {PLAYER}!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_NoHatchedEggMon_ELMIThoughtThe {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¿{PLAYER}?\nCreía que el HUEVO había eclosionado.\l¿Dónde está el {POKEMON}?"
		_: "ELM: {PLAYER}?\n"
                   "I thought the EGG hatched.\l"
                   "Where is the {POKEMON}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_GiveEverstone_ThanksYouReHelping {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Gracias, {PLAYER}! ¡Nos ayudas a\ndesvelar los misterios de los {POKEMON}!\pQuiero que aceptes esto como\nmuestra de nuestro agradecimiento."
		_: "Thanks, {PLAYER}! You're helping\n"
                   "unravel {POKEMON} mysteries for us!\p"
                   "I want you to have this as a token\n"
                   "of our appreciation."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_GiveEverstone_OhYouDonT {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Eh? No tienes sitio para\nla PIEDRA ETERNA…"
		_: "Oh? You don't have any room\n"
                   "for the EVERSTONE…"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_GiveEverstone_ReceivedTheEVERSTONEFrom {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} recibió la PIEDRA\nETERNA del PROF. ELM."
		_: "{PLAYER} received the EVERSTONE\n"
                   "from PROF. ELM."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Elm_GiveEverstone_ThatSAnEVERSTONE {
	poryswitch(LANGUAGE) {
		SPANISH: "Esa es una PIEDRA ETERNA.\pAlgunas especies de {POKEMON} evolucionan\nal alcanzar ciertos niveles.\pUn {POKEMON} que lleve la PIEDRA\nETERNA no evolucionará.\pDásela a un {POKEMON} que no\nquieras que evolucione."
		_: "That's an EVERSTONE.\p"
                   "Some species of {POKEMON} evolve\n"
                   "when they grow to certain levels.\p"
                   "A {POKEMON} holding the EVERSTONE\n"
                   "won't evolve.\p"
                   "Give it to a {POKEMON} you don't want\n"
                   "to evolve."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmIntroduction_ELMThereYouAre {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡{PLAYER}!\n¡Aquí estás!\l¡Tenía que pedirte un favor!\pEstoy investigando {POKEMON}\nahora mismo, y me preguntaba si\lpodrías ayudarme, {PLAYER}.\pVerás…\pEstoy escribiendo un artículo que\nquiero presentar en un congreso.\pPero hay cosas que aún no\nentiendo del todo.\p¡Así que! Me gustaría que criaras\nun {POKEMON} que capturé hace poco."
		_: "ELM: {PLAYER}!\n"
                   "There you are!\l"
                   "I needed to ask you a favor.\p"
                   "I'm conducting {POKEMON} research\n"
                   "right now, and I was wondering if\l"
                   "you could help me with it, {PLAYER}.\p"
                   "You see…\p"
                   "I'm writing a paper that I want to\n"
                   "present at a conference.\p"
                   "But there are some things I don't\n"
                   "quite understand yet.\p"
                   "So! I'd like you to raise a {POKEMON}\n"
                   "that I recently caught."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmBeggingLoop_ButPleaseINeed {
	poryswitch(LANGUAGE) {
		SPANISH: "Pero…\n¡Por favor, necesito tu ayuda!"
		_: "But…\n"
                   "Please, I need your help!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmPostBegging_ThanksYouReA {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Gracias, {PLAYER}!\n¡Eres de gran ayuda!\pCuando anuncie mis hallazgos,\nseguro que profundizaremos un poco\lmás en los misterios de los {POKEMON}.\p¡Puedes contar con ello!"
		_: "Thanks, {PLAYER}!\n"
                   "You're a great help!\p"
                   "When I announce my findings, I'm\n"
                   "sure we'll delve a bit deeper into\l"
                   "the many mysteries of {POKEMON}.\p"
                   "You can count on it!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmPostBegging_OhHeyIGot {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Oh, vaya!\n¡Tengo un e-mail!\p………………\nHm… Ajá…\lVale…"
		_: "Oh, hey!\n"
                   "I got an e-mail!\p"
                   "………………\n"
                   "Hm… Uh-huh…\l"
                   "Okay…"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmPostBegging_HeyListenPI {
	poryswitch(LANGUAGE) {
		SPANISH: "Eh, escucha.\pConozco a alguien llamado\nSR. {POKEMON}.\pSiempre encuentra cosas raras y\nhabla emocionado de sus descubrimientos.\pDe todos modos, acabo de recibir\nun e-mail suyo diciendo que esta vez es real.\pEs intrigante, pero estamos ocupados\ncon nuestra investigación {POKEMON}…\p¡Espera!\n¡Ya sé!\p{PLAYER}, ¿puedes ir en nuestro lugar?"
		_: "Hey, listen.\p"
                   "I have an acquaintance called\n"
                   "MR. {POKEMON}.\p"
                   "He keeps finding weird things and\n"
                   "raving about his discoveries.\p"
                   "Anyway, I just got an e-mail from\n"
                   "him saying that this time it's real.\p"
                   "It is intriguing, but we're busy with\n"
                   "our {POKEMON} research…\p"
                   "Wait!\n"
                   "I know!\p"
                   "{PLAYER}, can you go in our place?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmPostBegging_IWantYouTo {
	poryswitch(LANGUAGE) {
		SPANISH: "Quiero que cuides de uno de los\n{POKEMON} de estas\l{POKE} BALLS.\p¡Serás el primer compañero de\nese {POKEMON}, {PLAYER}!\pVenga.\n¡Elige uno!"
		_: "I want you to raise one of the\n"
                   "{POKEMON} contained in these\l"
                   "{POKE} BALLS.\p"
                   "You'll be that {POKEMON}'s first\n"
                   "partner, {PLAYER}!\p"
                   "Go on, then.\n"
                   "Pick one!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmWaitDontGo_ELMWaitWhereAre {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Espera!\n¿Adónde vas?"
		_: "ELM: Wait!\n"
                   "Where are you going?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ItContainsAPokemon {
	poryswitch(LANGUAGE) {
		SPANISH: "Contiene un {POKEMON} capturado\npor el PROF. ELM."
		_: "It contains a {POKEMON} caught by\n"
                   "PROF. ELM."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ELMHmCHIKORITAIs {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Hm! Has elegido CHIKORITA.\nTómate tu tiempo para criarlo.\pEntonces, {PLAYER}, ¿te gusta CHIKORITA,\nel {POKEMON} de tipo PLANTA?"
		_: "ELM: Hm! CHIKORITA is your choice.\n"
                   "Take your time raising it.\p"
                   "So, {PLAYER}, do you like CHIKORITA,\n"
                   "the GRASS {POKEMON}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ELMAhTOTODILEIs {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Ah! Has elegido TOTODILE.\nSerá gratificante criarlo.\pEntonces, {PLAYER}, ¿quieres TOTODILE,\nel {POKEMON} de tipo AGUA?"
		_: "ELM: Ah! TOTODILE is your choice.\n"
                   "It would be rewarding to raise.\p"
                   "So, {PLAYER}, do you want TOTODILE,\n"
                   "the WATER {POKEMON}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ELMOhCYNDAQUILIs {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Oh! Has elegido CYNDAQUIL.\nSerá fácil criarlo.\pEntonces, {PLAYER}, ¿te quedas con CYNDAQUIL,\nel {POKEMON} de tipo FUEGO?"
		_: "ELM: Oh! CYNDAQUIL is your choice.\n"
                   "Raising it would be a cinch.\p"
                   "So, {PLAYER}, you'll take CYNDAQUIL,\n"
                   "the FIRE {POKEMON}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ELMThinkItOver {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: Piénsalo con cuidado.\nTu compañero es importante."
		_: "ELM: Think it over carefully.\n"
                   "Your partner is important."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ELMIThinkThat {
	poryswitch(LANGUAGE) {
		SPANISH: "ELM: ¡Creo que también es un\ngran {POKEMON}!"
		_: "ELM: I think that's a great\n"
                   "{POKEMON} too!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_ReceivedTheSTR_VAR_1From {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} recibió el {STR_VAR_1}\ndel PROF. ELM!"
		_: "{PLAYER} received the {STR_VAR_1}\n"
                   "from PROF. ELM!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_MRPokemonLivesA {
	poryswitch(LANGUAGE) {
		SPANISH: "El SR. {POKEMON} vive un poco más\nallá de PUEBLO CEREZO.\pEs casi todo recto,\nasí que no te perderás.\pPero por si acaso, aquí tienes mi\nnúmero. ¡Llámame si surge algo!"
		_: "MR. {POKEMON} lives a bit beyond\n"
                   "CHERRYGROVE, the next city over.\p"
                   "It's almost a direct route there,\n"
                   "so you can't miss it.\p"
                   "But just in case, here's my number.\n"
                   "Call me if anything comes up!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_GotPROFELMS {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} obtuvo el número de teléfono\ndel PROF. ELM."
		_: "{PLAYER} got PROF. ELM's phone\n"
                   "number."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_IfYourPokemonIs {
	poryswitch(LANGUAGE) {
		SPANISH: "Si tu {POKEMON} está herido, debes\ncurarlo con esta máquina.\lÚsala cuando quieras."
		_: "If your {POKEMON} is hurt, you should\n"
                   "heal it with this machine.\l"
                   "Feel free to use it anytime."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_PokeBallMain_IMCountingOn {
	poryswitch(LANGUAGE) {
		SPANISH: "¡{PLAYER}, cuento contigo!"
		_: "{PLAYER}, I'm counting on you!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_AidePotionMain_IWantYouTo {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER}, quiero que te quedes con\nesto para tu recado."
		_: "{PLAYER}, I want you to have this\n"
                   "for your errand."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_AidePotionMain_ReceivedThePOTIONFrom {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} recibió la POCIÓN\ndel AYUDANTE."
		_: "{PLAYER} received the POTION\n"
                   "from the AIDE."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_OfficerMain_IHeardAPokemon {
	poryswitch(LANGUAGE) {
		SPANISH: "He oído que robaron un {POKEMON}\nde aquí…\pEstaba recogiendo información\ndel PROF. ELM.\pAl parecer, era un joven con el\npelo largo y rojo…\p¿Qué? ¿Dices que luchaste contra\nun ENTRENADOR así?\p¿Te acordaste de su nombre?"
		_: "I heard a {POKEMON} was stolen from\n"
                   "here…\p"
                   "I was just getting some information\n"
                   "from PROF. ELM.\p"
                   "Apparently, it was a young male with\n"
                   "long, red hair…\p"
                   "What? You're saying you battled a\n"
                   "TRAINER like that?\p"
                   "Did you happen to get his name?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Officer_NameRival_LetMeMakeSure {
	poryswitch(LANGUAGE) {
		SPANISH: "Voy a comprobar que lo he\nentendido bien…\n¿Así que se llama {RIVAL}?"
		_: "Let me make sure I got that right…\n"
                   "So his name is {RIVAL}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Officer_NameRival_OkaySoRIVALWas {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Bien! Así que su nombre\nes {RIVAL}\p¡Gracias por tu colaboración!"
		_: "Okay! So {RIVAL} was his name.\n"
                   "Thanks for helping my investigation!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_UseTheseOnYour {
	poryswitch(LANGUAGE) {
		SPANISH: "¡{PLAYER}!\n¡Úsalas en tu aventura {POKEDEX}!"
		_: "{PLAYER}!\n"
                   "Use these on your {POKEDEX} quest!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_ReceivedThePOKEBALLS {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} recibió {POKE} BALLS."
		_: "{PLAYER} received the {POKE} BALLS\n"
                   "from the AIDE."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_AideBallsMain_ToAddToYour {
	poryswitch(LANGUAGE) {
		SPANISH: "Atrapa {POKEMON} para\ncompletar tu {POKEDEX}.\pAtrapa {POKEMON} salvajes\nusando las {POKE} BALL."
		_: "To add to your {POKEDEX}, you have\n"
                   "to catch {POKEMON}.\p"
                   "Throw {POKE} BALLS at wild {POKEMON}\n"
                   "to get them."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Aide_SighThatStolen {
	poryswitch(LANGUAGE) {
		SPANISH: "…uf… Ese {POKEMON} robado.\nMe pregunto cómo estará.\pDicen que un {POKEMON} criado por\nuna mala persona se vuelve malo."
		_: "…sigh… That stolen {POKEMON}.\n"
                   "I wonder how it's doing.\p"
                   "They say a {POKEMON} raised by a bad\n"
                   "person turns bad itself."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Aide_ToAddToYour {
	poryswitch(LANGUAGE) {
		SPANISH: "Para ampliar tu {POKEDEX}, tienes\nque atrapar {POKEMON}.\pLanza {POKE} BALLS a {POKEMON} salvajes\npara atraparlos."
		_: "To add to your {POKEDEX}, you have\n"
                   "to catch {POKEMON}.\p"
                   "Throw {POKE} BALLS at wild {POKEMON}\n"
                   "to get them."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Aide_ThereWasALoud {
	poryswitch(LANGUAGE) {
		SPANISH: "Hubo un ruido fuerte afuera…\pCuando fuimos a mirar, alguien robó\nun {POKEMON} de la mesa.\p¡Es increíble que alguien\nhiciera eso!\p…uf… Ese {POKEMON} robado.\nMe pregunto cómo estará.\pDicen que un {POKEMON} criado por\nuna mala persona se vuelve malo."
		_: "There was a loud noise outside…\p"
                   "When we went to look, someone stole\n"
                   "a {POKEMON} off the table.\p"
                   "It's unbelievable that anyone would\n"
                   "do that!\p"
                   "…sigh… That stolen {POKEMON}.\n"
                   "I wonder how it's doing.\p"
                   "They say a {POKEMON} raised by a bad\n"
                   "person turns bad itself."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_OpenWindow_TheWindowIsOpen {
	poryswitch(LANGUAGE) {
		SPANISH: "La ventana está abierta.\nEntra una brisa agradable."
		_: "The window is open.\n"
                   "A pleasant breeze is blowing in."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_OpenWindow_HeMustVeBroken {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Debe haber entrado\npor aquí!"
		_: "He must've broken in through here!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_HealingMachine_WonderWhatThisMachine {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Qué hace esta máquina?"
		_: "Wonder what this machine does?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_HealingMachine_WouldYouLikeTo {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Quieres curar a tus {POKEMON}?"
		_: "Would you like to heal your {POKEMON}?"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_ElmsPC_OBSERVATIONSONPokemon {
	poryswitch(LANGUAGE) {
		SPANISH: "En la pantalla pone:\n“OBSERVACIONES SOBRE LA EVOLUCIÓN\n{POKEMON}”…"
		_: "“OBSERVATIONS ON {POKEMON}\n"
                   "EVOLUTION”, it says on the screen…"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_TrashCan_TheWrapperFromThe {
	poryswitch(LANGUAGE) {
		SPANISH: "Dentro está el envoltorio del\naperitivo que comió el PROF.\nELM…"
		_: "The wrapper from the snack PROF.\n"
                   "ELM ate is in there…"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Shelf1_TravelTip1Press {
	poryswitch(LANGUAGE) {
		SPANISH: "Consejo de viaje 1:\nPulsa START para abrir el MENÚ."
		_: "Travel Tip 1:\n"
                   "Press START to open the MENU."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Shelf2_TravelTip2Record {
	poryswitch(LANGUAGE) {
		SPANISH: "Consejo de viaje 2:\n¡Registra tu viaje con GUARDAR!"
		_: "Travel Tip 2:\n"
                   "Record your trip with SAVE!"
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Shelf3_TravelTip3Open {
	poryswitch(LANGUAGE) {
		SPANISH: "Consejo de viaje 3:\nAbre la MOCHILA y pulsa SELECT\lpara mover objetos."
		_: "Travel Tip 3:\n"
                   "Open your BAG and press SELECT\l"
                   "to move items."
	}
}

text NewBarkTown_ProfessorElmsLab_Text_Shelf4_TravelTip4Check {
	poryswitch(LANGUAGE) {
		SPANISH: "Consejo de viaje 4:\nConsulta los movimientos de tus {POKEMON}.\lPulsa el Botón A para cambiar movimientos."
		_: "Travel Tip 4:\n"
                   "Check your {POKEMON} moves.\l"
                   "Press the A Button to switch moves."
	}
}
