	walk_down
	walk_left
	face_up
}

movement NewBarkTown_ProfessorElmsLab_Movement_Delay64FaceDown {
	delay_16 * 4
	walk_in_place_fastest_down
}

movement NewBarkTown_ProfessorElmsLab_Movement_WalkToElmFrom103 {
