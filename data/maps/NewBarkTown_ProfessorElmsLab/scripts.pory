	delay_16 * 3
	walk_in_place_fastest_right
}

movement NewBarkTown_ProfessorElmsLab_Movement_PlayerToOfficerFromRight {
	walk_up * 3
	face_left
}

script NewBarkTown_ProfessorElmsLab_EventScript_OfficerMain {
    waitmovement(0)
    textcolor(MSG_COLOR_BLUE)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("He oído que robaron un {POKEMON}\nde aquí…\pEstaba recogiendo información\ndel PROF. ELM.\pAl parecer, era un joven con el\npelo largo y rojo…\p¿Qué? ¿Dices que luchaste contra\nun ENTRENADOR así?\p¿Te acordaste de su nombre?")
    	_: msgbox("I heard a {POKEMON} was stolen from\n"
               "here…\p"
               "I was just getting some information\n"
               "from PROF. ELM.\p"
               "Apparently, it was a young male with\n"
               "long, red hair…\p"
               "What? You're saying you battled a\n"
               "TRAINER like that?\p"
               "Did you happen to get his name?")
    }
    goto(NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival)
}

script NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival {
    fadescreen(FADE_TO_BLACK)
    special(SetRivalNickname)
    waitstate
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Voy a comprobar que lo he\nentendido bien…\n¿Así que se llama {RIVAL}?", MSGBOX_YESNO)
    	_: msgbox("Let me make sure I got that right…\n"
               "So his name is {RIVAL}?", MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_ProfessorElmsLab_EventScript_Officer_NameRival)
    }
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡Vale! Así que se llamaba {RIVAL}.\n¡Gracias por ayudar en la investigación!")
    	_: msgbox("Okay! So {RIVAL} was his name.\n"
               "Thanks for helping my investigation!")
    }
    closemessage
    applymovement(OBJ_EVENT_ID_OFFICER, NewBarkTown_ProfessorElmsLab_Movement_OfficerLeaves)
    waitmovement(0)
    removeobject(OBJ_EVENT_ID_OFFICER)
    setvar(VAR_ELM_LAB_STATE, 5)
    releaseall
}

movement NewBarkTown_ProfessorElmsLab_Movement_OfficerLeaves {
    walk_down * 6
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls1 {
    lockall
    setvar(VAR_TEMP_1, 0)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToLeftTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls2 {
    lockall
    setvar(VAR_TEMP_1, 1)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToMiddleTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBalls3 {
    lockall
    setvar(VAR_TEMP_1, 2)
    applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideToRightTrigger)
    goto(NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain)
}

script NewBarkTown_ProfessorElmsLab_EventScript_AideBallsMain {
    waitmovement(0)
    textcolor(MSG_COLOR_BLUE)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¡{PLAYER}!\n¡Usa estas en tu búsqueda de la {POKEDEX}!")
    	_: msgbox("{PLAYER}!\n"
               "Use these on your {POKEDEX} quest!")
    }
        poryswitch(LANGUAGE) {
    	SPANISH: giveitem_msg("{PLAYER} recibió las {POKE} BALLS\ndel AYUDANTE.", ITEM_POKE_BALL, 5)
    	_: giveitem_msg("{PLAYER} received the {POKE} BALLS\n"
               "from the AIDE.", ITEM_POKE_BALL, 5)
    }
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Para ampliar tu {POKEDEX}, tienes\nque atrapar {POKEMON}.\pLanza {POKE} BALLS a {POKEMON} salvajes\npara atraparlos.")
    	_: msgbox("To add to your {POKEDEX}, you have\n"
               "to catch {POKEMON}.\p"
               "Throw {POKE} BALLS at wild {POKEMON}\n"
               "to get them.")
    }
    closemessage
    switch (var(VAR_TEMP_1))
    {
        case 0:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromLeftTrigger)
        case 1:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromMiddleTrigger)
        case 2:
            applymovement(OBJ_EVENT_ID_AIDE, NewBarkTown_ProfessorElmsLab_Movement_AideFromRightTrigger)
    }
    waitmovement(0)
    setvar(VAR_ELM_LAB_STATE, 7)
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_Aide {
    lock
    faceplayer
    if (flag(FLAG_GOT_ELMS_EGG))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("…uf… Ese {POKEMON} robado.\nMe pregunto cómo estará.\pDicen que un {POKEMON} criado por\nuna mala persona se vuelve malo.")
        	_: msgbox("…sigh… That stolen {POKEMON}.\n"
                   "I wonder how it's doing.\p"
                   "They say a {POKEMON} raised by a bad\n"
                   "person turns bad itself.")
        }
    }
    elif (flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Para ampliar tu {POKEDEX}, tienes\nque atrapar {POKEMON}.\pLanza {POKE} BALLS a {POKEMON} salvajes\npara atraparlos.")
        	_: msgbox("To add to your {POKEDEX}, you have\n"
                   "to catch {POKEMON}.\p"
                   "Throw {POKE} BALLS at wild {POKEMON}\n"
                   "to get them.")
        }
    }
    elif (flag(FLAG_RECEIVED_MYSTERY_EGG))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Hubo un ruido fuerte afuera…\pCuando fuimos a mirar, alguien robó\nun {POKEMON} de la mesa.\p¡Es increíble que alguien\nhiciera eso!\p…uf… Ese {POKEMON} robado.\nMe pregunto cómo estará.\pDicen que un {POKEMON} criado por\nuna mala persona se vuelve malo.")
        	_: msgbox("There was a loud noise outside…\p"
                   "When we went to look, someone stole\n"
                   "a {POKEMON} off the table.\p"
                   "It's unbelievable that anyone would\n"
                   "do that!\p"
                   "…sigh… That stolen {POKEMON}.\n"
                   "I wonder how it's doing.\p"
                   "They say a {POKEMON} raised by a bad\n"
                   "person turns bad itself.")
        }
    }
    else
    {
        msgbox(NewBarkTown_ProfessorElmsLab_Text_Aide_AlwaysBusy)
    }
    release
}

script NewBarkTown_ProfessorElmsLab_EventScript_OpenWindow {
    if (flag(FLAG_VISITED_VIOLET_CITY) || !flag(FLAG_ELM_CALLED_ABOUT_STOLEN_MON))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("La ventana está abierta.\nEntra una brisa agradable.", MSGBOX_SIGN)
        	_: msgbox("The window is open.\n"
                   "A pleasant breeze is blowing in.", MSGBOX_SIGN)
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Debe haber entrado por aquí!", MSGBOX_SIGN)
        	_: msgbox("He must've broken in through here!", MSGBOX_SIGN)
        }
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_HealingMachine {
    lockall
    if (!flag(FLAG_SYS_POKEMON_GET))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿Qué hace esta máquina?")
        	_: msgbox("Wonder what this machine does?")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿Quieres curar a tus {POKEMON}?", MSGBOX_YESNO)
        	_: msgbox("Would you like to heal your {POKEMON}?", MSGBOX_YESNO)
        }
        if (var(VAR_RESULT) == YES)
        {
            closemessage
            delay(24)
            dofieldeffect(FLDEFF_POKECENTER_HEAL)
            waitfieldeffect(FLDEFF_POKECENTER_HEAL)
            special(HealPlayerParty)
        }
    }
    releaseall
}

script NewBarkTown_ProfessorElmsLab_EventScript_ElmsPC {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("En la pantalla pone:\n“OBSERVACIONES SOBRE LA EVOLUCIÓN\n{POKEMON}”…", MSGBOX_SIGN)
    	_: msgbox("“OBSERVATIONS ON {POKEMON}\n"
               "EVOLUTION”, it says on the screen…", MSGBOX_SIGN)
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_TrashCan {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Dentro está el envoltorio del\naperitivo que comió el PROF.\nELM…", MSGBOX_SIGN)
    	_: msgbox("The wrapper from the snack PROF.\n"
               "ELM ate is in there…", MSGBOX_SIGN)
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf1 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Consejo de viaje 1:\nPulsa START para abrir el MENÚ.")
    	_: msgbox("Travel Tip 1:\n"
               "Press START to open the MENU.")
    }
    normalmsg
    releaseall
}

text NewBarkTown_ProfessorElmsLab_Text_ShelfIntro {
    poryswitch(LANGUAGE) {
        SPANISH: "{PLAYER} abrió un libro."
        _: "{PLAYER} opened a book."
    }
}

script NewBarkTown_ProfessorElmsLab_EventScript_Shelf2 {
    lockall
    msgbox(NewBarkTown_ProfessorElmsLab_Text_ShelfIntro)
    signmsg
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Consejo de viaje 2:\n¡Registra tu viaje con GUARDAR!")
    	_: msgbox("Travel Tip 2:\n"
               "Record your trip with SAVE!")
    }
    normalmsg
    releaseall
}

