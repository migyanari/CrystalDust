mapscripts Route32_PokemonCenter_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_LANDMARK_ROUTE_32_POKEMON_CENTER)
        setrespawn(HEAL_LOCATION_ROUTE32)
    }
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script Route32_PokemonCenter_1F_EventScript_Nurse {
    setvar(VAR_0x800B, 1)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
}

script Route32_PokemonCenter_1F_EventScript_FishingGuru {
    lock
    faceplayer
    if (!flag(FLAG_RECEIVED_OLD_ROD))
    {
        msgbox(Route32_PokemonCenter_1F_Text_FishingGuru_Question, MSGBOX_YESNO)
        if (var(VAR_RESULT))
        {
            msgbox(Route32_PokemonCenter_1F_Text_FishingGuru_Yes)
            giveitem(ITEM_OLD_ROD)
            msgbox(Route32_PokemonCenter_1F_Text_FishingGuru_GiveOldRod)
            setflag(FLAG_RECEIVED_OLD_ROD)
        }
        else
        {
            msgbox(Route32_PokemonCenter_1F_Text_FishingGuru_No)
        }
    }
    else
    {
        msgbox(Route32_PokemonCenter_1F_Text_FishingGuru_After)
    }
    release
}

script Route32_PokemonCenter_1F_EventScript_HoldItemGirl {
    msgbox(Route32_PokemonCenter_1F_Text_HoldItemGirl, MSGBOX_NPC)
}

text Route32_PokemonCenter_1F_Text_FishingGuru_Question {
    poryswitch(LANGUAGE) {
        SPANISH: "Éste es un buen sitio para pescar.\n¿Has visto a gente pescando?\p¿Y tú?\n¿Quieres una de mis CAÑAS?"
        _: "This is a great fishing spot.\nOh, you saw people fishing?\pHow about you?\nWould you like one of my RODS?"
    }
}

text Route32_PokemonCenter_1F_Text_FishingGuru_Yes {
    poryswitch(LANGUAGE) {
        SPANISH: "Eso está bien.\n¡Ahora ya puedes pescar!"
        _: "Heh, that's good to hear.\nNow you're an angler too!"
    }
}

text Route32_PokemonCenter_1F_Text_FishingGuru_GiveOldRod {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Pescar es genial!\nSi ves agua, ya sea el mar o un río,\lutiliza tu CAÑA."
        _: "Fishing is great!\nIf there's water, be it the sea or\la stream, try out your ROD."
    }
}

text Route32_PokemonCenter_1F_Text_FishingGuru_No {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Vaya!\nMe has decepcionado…"
        _: "Oh.\nThat's rather disappointing…"
    }
}

text Route32_PokemonCenter_1F_Text_FishingGuru_After {
    poryswitch(LANGUAGE) {
        SPANISH: "Hola.\n¿Están picando?"
        _: "Yo, kid.\nHow are they biting?"
    }
}

text Route32_PokemonCenter_1F_Text_HoldItemGirl {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Cómo equipar a mi {POKEMON}?\pQuizá con un objeto que aumente\nsu ATAQUE…"
        _: "What item should I make my\n{POKEMON} hold?\pMaybe something that increases the\npower of its attacks…"
    }
}