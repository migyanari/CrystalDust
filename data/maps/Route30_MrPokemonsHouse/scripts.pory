mapscripts Route30_MrPokemonsHouse_MapScripts{
	MAP_SCRIPT_ON_FRAME_TABLE[
		VAR_MR_POKEMONS_HOUSE_STATE, 0: Route30_MrPokemonsHouse_MapScript_MrPokemonIntro
	]
}

script Route30_MrPokemonsHouse_MapScript_MrPokemonIntro{
	lockall
	textcolor(MSG_COLOR_BLUE)
	playse(SE_PIN)
	applymovement(1, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(1, Common_Movement_Delay48)
	waitmovement(0)
	applymovement(1, Common_Movement_WalkInPlaceFastestDown)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_Greeting)
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Route30_MrPokemonsHouse_Movement_PlayerToMrPokemon)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_GiveEgg)
	giveitem(ITEM_MYSTERY_EGG)
	setflag(FLAG_RECEIVED_MYSTERY_EGG)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_EggStory)
	applymovement(1, Common_Movement_WalkInPlaceFastestRight)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_OakRecognizes)
	applymovement(1, Common_Movement_WalkInPlaceFastestDown)
	applymovement(2, Common_Movement_WalkInPlaceFastestLeft)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_ElmWillKnow)
	closemessage
	playbgm(MUS_OAKS_THEME, 0)
	applymovement(OBJ_EVENT_ID_PLAYER, Route30_MrPokemonsHouse_Movement_PauseThenTurnRight)
	applymovement(2, Route30_MrPokemonsHouse_Movement_OakToPlayer)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_OakIntro)
	textcolor(MSG_COLOR_SYS)
	playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
	poryswitch(LANGUAGE) {
		SPANISH: message("{PLAYER} recibió la {POKEDEX}\ndel PROF. OAK.")
		_: message("{PLAYER} received the {POKEDEX}\nfrom PROF. OAK.")
	}
	waitmessage
	waitfanfare
	textcolor(MSG_COLOR_PREV)
	setflag(FLAG_SYS_POKEDEX_GET)
	msgbox(Route30_MrPokemonsHouse_Text_OakFarewell)
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Route30_MrPokemonsHouse_Movement_PauseThenTurnDown)
	applymovement(2, Route30_MrPokemonsHouse_Movement_OakToDoor)
	waitmovement(0)
	delay(10)
	playse(SE_EXIT)
	fadedefaultbgm
	removeobject(2)
	waitse
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFastestUp)
	waitmovement(0)
	msgbox(Route30_MrPokemonsHouse_Text_Intro_HealParty)
	closemessage
	call(Common_EventScript_OutOfCenterPartyHeal)
	msgbox(Route30_MrPokemonsHouse_Text_DependingOnYou)
	closemessage
	turnobject(1, DIR_EAST)
	setrespawn(HEAL_LOCATION_CHERRYGROVE_CITY)
	setflag(FLAG_HIDE_NEW_BARK_TOWN_RIVAL)
	setflag(FLAG_HIDE_NEW_BARK_TOWN_PLAYERS_HOUSE_1F_NEIGHBOR)
	clearflag(FLAG_HIDE_NEW_BARK_TOWN_NEIGHBORS_HOUSE_NEIGHBOR)
	clearflag(FLAG_HIDE_NEW_BARK_TOWN_ELMS_LAB_OFFICER)
	setvar(VAR_CHERRYGROVE_CITY_STATE, 1)
	setvar(VAR_ELM_LAB_STATE, 4)
	switch(var(VAR_STARTER_MON))
	{
		case STARTER_CHIKORITA:
			setflag(FLAG_HIDE_NEW_BARK_TOWN_ELMS_LAB_POKEBALL_CYNDAQUIL)
		case STARTER_TOTODILE:
			setflag(FLAG_HIDE_NEW_BARK_TOWN_ELMS_LAB_POKEBALL_CHIKORITA)
		case STARTER_CYNDAQUIL:
			setflag(FLAG_HIDE_NEW_BARK_TOWN_ELMS_LAB_POKEBALL_TOTODILE)
	}
	setflag(FLAG_FORCED_CALL_ELM_STOLEN_MON)
	setvar(VAR_MR_POKEMONS_HOUSE_STATE, 1)
	releaseall
	end
}

movement(local) Route30_MrPokemonsHouse_Movement_PlayerToMrPokemon{
	walk_right
	walk_up
}

movement(local) Route30_MrPokemonsHouse_Movement_PauseThenTurnRight{
	delay_16
	walk_in_place_fastest_right
}

movement(local) Route30_MrPokemonsHouse_Movement_OakToPlayer{
	walk_down
	walk_left * 4
}

movement(local) Route30_MrPokemonsHouse_Movement_PauseThenTurnDown{
	delay_16
	walk_in_place_fastest_down
}

movement(local) Route30_MrPokemonsHouse_Movement_OakToDoor{
	walk_down
	walk_left * 2
	face_down
}

script Route30_MrPokemonsHouse_EventScript_MrPokemon{
	lock
	faceplayer
	checkitem(ITEM_RED_SCALE, 1)
	if(var(VAR_RESULT))
	{
		msgbox(Route30_MrPokemonsHouse_Text_RedScaleTrade, MSGBOX_YESNO)
		if(!var(VAR_RESULT))
		{
			msgbox(Route30_MrPokemonsHouse_Text_RedScaleDecline)
			release
			end
		}
		checkitemspace(ITEM_EXP_SHARE, 1)
		if(!var(VAR_RESULT))
		{
			call(Common_EventScript_BagIsFull)
			release
			end
		}
		giveitem(ITEM_EXP_SHARE, 1)
		removeitem(ITEM_RED_SCALE, 1)
	}
	if(flag(FLAG_ADVENTURE_STARTED))
	{
		msgbox(Route30_MrPokemonsHouse_Text_LifeDelightful)
		release
		end
	}
	msgbox(Route30_MrPokemonsHouse_Text_DependingOnYou)
	release
	end
}

script Route30_MrPokemonsHouse_EventScript_ForeignMagazines{
	msgbox(Route30_MrPokemonsHouse_Text_ForeignMagazines, MSGBOX_SIGN)
	end
}

script Route30_MrPokemonsHouse_EventScript_BrokenComputer{
	msgbox(Route30_MrPokemonsHouse_Text_BrokenComputer, MSGBOX_SIGN)
	end
}

script Route30_MrPokemonsHouse_EventScript_StrangeCoins{
	msgbox(Route30_MrPokemonsHouse_Text_StrangeCoins, MSGBOX_SIGN)
	end
}

text Route30_MrPokemonsHouse_Text_Intro_Greeting {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Hola, hola!\n¡Debes de ser {PLAYER}!\pEl PROF. ELM me dijo que vendrías."
		_: "Hello, hello!\nYou must be {PLAYER}.\pPROF. ELM said that you would visit."
	}
}

text Route30_MrPokemonsHouse_Text_Intro_GiveEgg {
	poryswitch(LANGUAGE) {
		SPANISH: "Esto es lo que quiero que examine\nel PROF. ELM."
		_: "This is what I want PROF. ELM to\nexamine."
	}
}

text Route30_MrPokemonsHouse_Text_Intro_EggStory {
	poryswitch(LANGUAGE) {
		SPANISH: "Conozco a una pareja que tiene una\nGUARDERÍA POKÉMON. Ellos me dieron\nese HUEVO.\pComo me intrigaba, le mandé una\ncarta al PROF. ELM.\pEl PROF. ELM es la máxima autoridad\nen evolución de los {POKEMON}."
		_: "I know a couple who run a DAY CARE\nservice. They gave me that EGG.\pI was intrigued, so I sent mail to\nPROF. ELM.\pFor {POKEMON} evolution, PROF. ELM is\nthe authority."
	}
}

text Route30_MrPokemonsHouse_Text_Intro_OakRecognizes {
	poryswitch(LANGUAGE) {
		SPANISH: "Hasta el PROF. OAK lo reconoce."
		_: "Even PROF. OAK here recognizes that."
	}
}

text Route30_MrPokemonsHouse_Text_Intro_ElmWillKnow {
	poryswitch(LANGUAGE) {
		SPANISH: "Si tengo razón, el PROF. ELM\nsabrá qué hacer."
		_: "If my assumption is correct, PROF.\nELM will know what to do."
	}
}

text Route30_MrPokemonsHouse_Text_OakIntro {
	poryswitch(LANGUAGE) {
		SPANISH: "OAK: ¡Ajá!\n¡Así que eres {PLAYER}!\p¡Soy el PROF. OAK! Investigo a los\n{POKEMON}.\pEstaba visitando a mi viejo amigo,\nel SR. {POKEMON}.\pOí que estabas haciendo un recado\npara el PROF. ELM, así que te\nesperé aquí.\p¡Oh! ¿Qué es esto?\n¡Un {POKEMON} raro!\pVeamos…\pMmm…\p¡Ya veo!\pYa entiendo por qué el PROF. ELM te\ndió un {POKEMON} para este recado.\pLos investigadores como el PROF. ELM\ny yo somos amigos de los {POKEMON}.\pSe dio cuenta de que cuidarías a tu\n{POKEMON} con amor y cariño.\p¡Ah…!\pPareces ser muy responsable.\n¿Querrías ayudarme?\p¿Ves? Ésta es la última versión de\nla {POKEDEX}.\pGuarda automáticamente datos de los\n{POKEMON} que hayas visto o\lcapturado.\p¡Es una enciclopedia de alta\ntecnología!"
		_: "OAK: Aha!\nSo you're {PLAYER}!\pI'm PROF. OAK, a {POKEMON} researcher\nfrom the KANTO region.\pI was just visiting my old friend,\nMR. {POKEMON}.\pI heard you were running an errand\nfor PROF. ELM, so I waited here.\p…Oh! What's this?\nYou have a rare {POKEMON} with you!\pLet's see…\pHm, I see!\pI understand why PROF. ELM gave you\na {POKEMON} for this errand.\pTo researchers like PROF. ELM and I,\n{POKEMON} are our friends.\pHe saw that you would treat your\n{POKEMON} with love and care.\p…Ah!\pYou seem to be dependable.\nHow would you like to help me out?\pSee? This is the latest version of\nthe {POKEDEX}.\pIt automatically records data on\n{POKEMON} you've seen or caught.\pIt's a high-tech encyclopedia!"
	}
}

text Route30_MrPokemonsHouse_Text_OakFarewell {
	poryswitch(LANGUAGE) {
		SPANISH: "OAK: Ve a conocer todos los {POKEMON}\nque puedas y completa esa {POKEDEX}!\pLlevo demasiado tiempo aquí.\nTengo que ir a CIUDAD TRIGAL por\lmi programa de radio.\p¡{PLAYER}, cuento contigo!"
		_: "OAK: Go meet many kinds of {POKEMON}\nand complete that {POKEDEX}!\pBut, I've stayed too long.\nI have to get to GOLDENROD for my\lusual radio show.\p{PLAYER}, I'm counting on you!"
	}
}

text Route30_MrPokemonsHouse_Text_Intro_HealParty {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Vas a ir a ver al PROF. ELM?\pToma.\nTus {POKEMON} deberían descansar\nun poco."
		_: "You are returning to PROF. ELM?\pHere.\nYour {POKEMON} should have some rest."
	}
}

text Route30_MrPokemonsHouse_Text_DependingOnYou {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Confío en ti!"
		_: "I'm depending on you!"
	}
}

text Route30_MrPokemonsHouse_Text_RedScaleTrade {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Eh? ¡Esa ESCAMA!\n¿Qué es eso? ¿Un GYARADOS rojo?\p¡Qué raro!\nLa quiero…\p{PLAYER}, ¿me la cambias?\pTe ofrezco este REPARTIR EXP. que me\ndió el PROF. OAK."
		_: "Hm? That SCALE!\nWhat's that? A red GYARADOS?\pThat's rare!\nI, I want it…\p{PLAYER}, would you care to\ntrade it?\pI can offer this EXP. SHARE I got\nfrom PROF. OAK."
	}
}

text Route30_MrPokemonsHouse_Text_RedScaleDecline {
	poryswitch(LANGUAGE) {
		SPANISH: "Qué pena.\nEs algo muy raro."
		_: "That's disappointing.\nThat happens to be very rare."
	}
}

text Route30_MrPokemonsHouse_Text_LifeDelightful {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Qué maravillosa es la vida!\n¡Siempre hay nuevos descubrimientos!"
		_: "Life is delightful!\nAlways, new discoveries to be made!"
	}
}

text Route30_MrPokemonsHouse_Text_ForeignMagazines {
	poryswitch(LANGUAGE) {
		SPANISH: "Está lleno de revistas extranjeras.\nNi siquiera puedo leer los títulos."
		_: "It's a bookshelf packed with foreign\nmagazines.\pCan't even read their titles…"
	}
}

text Route30_MrPokemonsHouse_Text_BrokenComputer {
	poryswitch(LANGUAGE) {
		SPANISH: "Es un ordenador enorme.\n¡Mmm! Está estropeado."
		_: "It's a big mainframe computer.\nHm… It seems to be broken."
	}
}

text Route30_MrPokemonsHouse_Text_StrangeCoins {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Un montón de monedas extrañas!\nQuizá sean de otro país…"
		_: "It's a whole pile of strange coins.\nMaybe they're from another country…"
	}
}
