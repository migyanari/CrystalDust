mapscripts Route31_Gatehouse_MapScripts{}

script Route31_Gatehouse_EventScript_Officer{
	msgbox(Route31_Gatehouse_Text_Officer, MSGBOX_NPC)
	end
}

script Route31_Gatehouse_EventScript_Girl{
	msgbox(Route31_Gatehouse_Text_Girl, MSGBOX_NPC)
	end
}

// ---------------------------------------------------------------------------
// Texts
// ---------------------------------------------------------------------------

text Route31_Gatehouse_Text_Officer {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Hola!\n¿Has visitado la TORRE BELLSPROUT?"
		_: "Hi there!\nDid you visit SPROUT TOWER?"
	}
}

text Route31_Gatehouse_Text_Girl {
	poryswitch(LANGUAGE) {
		SPANISH: "Estoy demasiado lejos.\n¡Mejor que llame a casa!"
		_: "I came too far out.\nI'd better phone home!"
	}
}