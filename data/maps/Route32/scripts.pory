text Route32_Text_Trainer_Ralph_Seen {
    poryswitch(LANGUAGE) {
        SPANISH: "Soy muy bueno, tanto pescando\ncomo con los {POKEMON}.\p¡No voy a perder con alguien tan\njoven!"
        _: "I'm really good at both fishing\nand {POKEMON}.\pI'm not about to lose to any kid!"
    }
}

text Route32_Text_Trainer_Ralph_Lost {
    poryswitch(LANGUAGE) {
        SPANISH: "Intenté acelerar las cosas…"
