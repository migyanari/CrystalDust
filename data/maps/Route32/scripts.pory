script Route32_EventScript_Ralph {
    trainerbattle_single(TRAINER_RALPH_1, Route32_Text_Trainer_Ralph_Seen, Route32_Text_Trainer_Ralph_Lost)
    specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if(var(VAR_RESULT) == TRUE)
    {
        trainerbattle_rematch(TRAINER_RALPH_1, Route32_Text_Trainer_Ralph_Rematch, Route32_Text_Trainer_Ralph_Lost)
    }
    if (!flag(FLAG_PHONE_CARD_FISHER_RALPH))
    {
        if (!flag(FLAG_FISHER_RALPH_OFFERED_NUMBER))
        {
            msgbox(Route32_Text_Trainer_Ralph_AskNumber, MSGBOX_YESNO) 
            setflag(FLAG_FISHER_RALPH_OFFERED_NUMBER)
        }
        else
        {
            msgbox(Route32_Text_Trainer_Ralph_AskNumberAgain, MSGBOX_YESNO)
        }
        if (var (VAR_RESULT) == YES)
        {
            registerphonecontact(FLAG_PHONE_CARD_FISHER_RALPH) 
            msgbox(Route32_Text_Trainer_Ralph_AfterRegistered, MSGBOX_AUTOCLOSE)
        }
        else
        {
            msgbox(Route32_Text_Trainer_Ralph_AfterDeclined, MSGBOX_AUTOCLOSE)
        }
        end
    }
    msgbox(Route32_Text_Trainer_Ralph_AfterRegistered, MSGBOX_DEFAULT)
    release
}

