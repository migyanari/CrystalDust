    }
}

text Route32_Text_Trainer_Ralph_Rematch {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Eh, joven!\n¡Hoy no pienso perder!"
        _: "Hey kid!\nNo losing for me this day!"
    }
}

text Route32_Text_Trainer_Ralph_AskNumber {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Pescar es una pasión eterna y los\n{POKEMON} son amigos eternos!\p¿La gente joven ya no pesca?\pHe visto {POKEMON} raros mientras\npescaba…\pA la gente joven os gustan\nlos {POKEMON} raros…\p¿Quieres mi número de teléfono?\nTe haré saber si veo alguno."
        _: "Fishing is a lifelong passion.\n{POKEMON} are lifelong friends!\pDon't young people fish anymore?\pI've seen rare {POKEMON} while I've\nbeen fishing…\lYou young people like that, right?\pWant to trade phone numbers?\nI'll let you know if I see anything."
    }
}

text Route32_Text_Trainer_Ralph_AskNumberAgain {
    poryswitch(LANGUAGE) {
        SPANISH: "Así que quieres mi teléfono por si\nveo {POKEMON} raros…"
        _: "Hm? So you do want me to phone if\nI see rare {POKEMON}?"
    }
}

text Route32_Text_Trainer_Ralph_AfterRegistered {
    poryswitch(LANGUAGE) {
        SPANISH: "Sí, te llamaré si veo {POKEMON} raros.\nNo te preocupes. ¡No me olvidaré!"
        _: "Yep, phone if I see rare {POKEMON}.\nDon't worry, I won't forget!"
    }
}

text Route32_Text_Trainer_Ralph_AfterDeclined {
    poryswitch(LANGUAGE) {
        SPANISH: "Oh… Ni siquiera mis propios hijos\nme dan sus números de teléfono…\l¿Es así la gente joven hoy en día?"
        _: "Oh… My own kids won't even give\nme their phone numbers…\lIs that how young people are today?"
    }
}

text Route32_Text_Trainer_Gordon_Seen {
    poryswitch(LANGUAGE) {
        SPANISH: "¡He encontrado {POKEMON} muy buenos\nen la hierba!\p¡Creo que me servirán!"
        _: "I found some good {POKEMON} in the\ngrass around here!\pI think they'll do it for me!"
    }
}

text Route32_Text_Trainer_Gordon_Lost {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Maldición!\nCreía que podía ganar."
        _: "Darn.\nI thought I could win."
    }
}

text Route32_Text_Trainer_Gordon_AfterBeaten {
    poryswitch(LANGUAGE) {
        SPANISH: "En la hierba hay cosas pegajosas."
        _: "The grass is full of clingy things."
    }
}

text Route32_Text_Trainer_Peter_Seen {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Esa MEDALLA!\n¡Es de CIUDAD MALVA!\p¿Ganaste a PEGASO?"
        _: "That BADGE!\nIt's from VIOLET CITY's GYM!\pYou beat FALKNER?"
    }
}

text Route32_Text_Trainer_Peter_Lost {
    poryswitch(LANGUAGE) {
        SPANISH: "Conozco mis debilidades."
        _: "I know what my weaknesses are."
    }
}

text Route32_Text_Trainer_Peter_AfterBeaten {
    poryswitch(LANGUAGE) {
        SPANISH: "Debería volver a entrenarme en el\nGIMNASIO de CIUDAD MALVA."
        _: "I should train again at the GYM\nin VIOLET CITY."
    }
}

text Route32_Text_RuinsOfAlphSign {
    poryswitch(LANGUAGE) {
        SPANISH: "RUINAS ALFA\nENTRADA ESTE"
        _: "RUINS OF ALPH\nEAST ENTRANCE"
    }
}

text Route32_Text_DirectionsSign {
    poryswitch(LANGUAGE) {
