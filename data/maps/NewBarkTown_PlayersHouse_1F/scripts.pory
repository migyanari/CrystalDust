text NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_DonTGiveUp {
	poryswitch(LANGUAGE) {
		SPANISH: "¡{PLAYER}, no te rindas!"
		_: "{PLAYER}, don't give up!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_YouHavenTSaved {
	poryswitch(LANGUAGE) {
		SPANISH: "No has ahorrado tanto."
		_: "You haven't saved that much."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_YouCanTTake {
	poryswitch(LANGUAGE) {
		SPANISH: "No puedes retirar tanto."
		_: "You can't take that much."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YourMoneySSafe {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Tu dinero está a salvo aquí!\n¡Adelante!"
		_: "Your money's safe here!\n"
                   "Get going!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YouDonTHave {
	poryswitch(LANGUAGE) {
		SPANISH: "No tienes tanto."
		_: "You don't have that much."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YouCanTSave {
	poryswitch(LANGUAGE) {
		SPANISH: "No puedes ahorrar tanto."
		_: "You can't save that much."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomLostBooklet_DoYouWantTo {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Quieres ajustar el reloj para el\nhorario de verano?"
		_: "Do you want to adjust your clock for\n"
                   "Daylight Saving Time?"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_MomLostBooklet_IThinkILost {
	poryswitch(LANGUAGE) {
		SPANISH: "Creo que he perdido el manual\nde instrucciones del {POKE}GEAR…\pTengo que ir a buscarlo.\nVuelve dentro de un rato."
		_: "I think I lost the instruction\n"
                   "booklet for the {POKE}GEAR…\p"
                   "I need to go look for it.\n"
                   "Come back again in a while."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_GoodMorningIM {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Buenos días, {PLAYER}!\n¡Estoy de visita!\p"
		_: "Good morning, {PLAYER}!\n"
                   "I'm visiting!\p"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_HelloIMVisiting {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Hola, {PLAYER}!\n¡Estoy de visita!\p"
		_: "Hello, {PLAYER}!\n"
                   "I'm visiting!\p"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_GoodEveningIM {
	poryswitch(LANGUAGE) {
		SPANISH: "¡Buenas tardes, {PLAYER}!\n¡Estoy de visita!\p"
		_: "Good evening, {PLAYER}!\n"
                   "I'm visiting!\p"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_HaveYouHeardP {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER}, ¿has oído?\pMi hija está empeñada en ser\nayudante del PROF. ELM.\l¡Le encantan los {POKEMON}!"
		_: "{PLAYER}, have you heard?\p"
                   "My daughter is adamant about\n"
                   "becoming PROF. ELM's assistant.\l"
                   "She really loves {POKEMON}!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_TV_ThereSAMovie {
	poryswitch(LANGUAGE) {
		SPANISH: "Hay una película en TV.\n"
                   "Dos chicos montan en un tren bajo\l"
                   "el cielo estrellado…\p"
                   "¡Será mejor que me ponga en marcha también!"
		_: "There's a movie on TV.\n"
                   "Stars dot the sky as two boys\l"
                   "ride on a train…\p"
                   "I'd better get rolling too!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_Stove_AADEPTARRANGINGFOR {
	poryswitch(LANGUAGE) {
		SPANISH: "UN ANUNCIO PUBLICITARIO PARA MAMÁ\nVOLCANO BAKEMEAT."
		_: "A ADEPT ARRANGING FOR MOTHER\n"
                   "VOLCANO BAKEMEAT."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_Stove_ItSMomS {
	poryswitch(LANGUAGE) {
		SPANISH: "¡La especialidad de mi madre!\n¡HAMBURGUESA VOLCÁN CANELA!"
		_: "It's Mom's specialty, the\n"
                   "CINNABAR VOLCANO BURGER!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_Sink_TheSinkIsSpotless {
	poryswitch(LANGUAGE) {
		SPANISH: "El fregadero está impecable.\nA mamá le gusta mantenerlo limpio."
		_: "The sink is spotless.\n"
                   "Mom likes to keep it clean."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_Fridge_LetSSeeWhat {
	poryswitch(LANGUAGE) {
		SPANISH: "Veamos qué hay en la nevera…\p¡AGUA FRESCA y una sabrosa\nLIMONADA!"
		_: "Let's see what's in the fridge…\p"
                   "FRESH WATER and tasty LEMONADE!"
	}
}
