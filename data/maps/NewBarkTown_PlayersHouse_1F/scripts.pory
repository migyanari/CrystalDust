const OBJ_EVT_MOM = 1

mapscripts NewBarkTown_PlayersHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_PLAYER_HOUSE_STATE) != 0)
        {
            gettime
            if (var(VAR_0x8002) == TIME_MORNING)
            {
                setobjectxyperm(OBJ_EVT_MOM, 2, 2)
                setobjectmovementtype(OBJ_EVT_MOM, MOVEMENT_TYPE_FACE_UP)
            }
            elif (var(VAR_0x8002) == TIME_NIGHT)
            {
                setobjectxyperm(OBJ_EVT_MOM, 1, 2)
                setobjectmovementtype(OBJ_EVT_MOM, MOVEMENT_TYPE_FACE_UP)
            }
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_PLAYER_HOUSE_STATE, 0 : NewBarkTown_PlayersHouse_1F_MomEncounter
    ]
}

script NewBarkTown_PlayersHouse_1F_MomEncounter {
    lockall
    textcolor(MSG_COLOR_RED)
    playse(SE_PIN)
    applymovement(OBJ_EVT_MOM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(OBJ_EVT_MOM, Common_Movement_Delay48)
    waitmovement(0)
    playbgm(MUS_MOMS_THEME, 0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFastestDown)
    applymovement(OBJ_EVT_MOM, NewBarkTown_PlayersHouse_1F_MomWalkToPlayer)
    waitmovement(0)
    delay(20)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("MAMÁ: ¡Ah, {PLAYER}…!\pNuestro vecino, el PROF. ELM,\nte estaba buscando.\pDijo que quería que le hicieras\nun favor.\p¡Ah! ¡Casi se me olvidaba!\nYa han traído tu {POKE}GEAR\ldel taller.\l¡Aquí tienes!")
    	_: msgbox("MOM: Oh, {PLAYER}…!\p"
                   "Our neighbor, PROF. ELM, was just\n"
                   "looking for you.\p"
                   "He said he wanted you to do\n"
                   "something for him.\p"
                   "Oh, I almost forgot! Your {POKEMON}\n"
                   "GEAR is back from the repair shop.\l"
                   "Here you go!")
    }
    textcolor(MSG_COLOR_PREV)
    playfanfare(MUS_OBTAIN_ITEM)
        poryswitch(LANGUAGE) {
    	SPANISH: message("{PLAYER} recibió el {POKE}GEAR.")
    	_: message("{PLAYER} received the {POKE}GEAR.")
    }
    waitfanfare
    setflag(FLAG_SYS_POKEGEAR_GET)
    setflag(FLAG_PHONE_CARD_MOM)
    textcolor(MSG_COLOR_RED)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("El {POKEMON} GEAR, o simplemente\n{POKE}GEAR.\nEs básico para ser un buen ENTRENADOR.\p¡Ah! Falta el día de la semana.\n¡No olvides ponerlo!")
    	_: msgbox("{POKEMON} GEAR, or just {POKE}GEAR.\n"
                   "It's essential if you want to be\l"
                   "a good TRAINER.\p"
                   "Oh, the day of the week isn't set.\n"
                   "You mustn't forget that!")
    }
    call(NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek)
    call(NewBarkTown_PlayersHouse_1F_MomDaylightSaving)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Vuelve a casa para cambiar de hora\nel reloj.\pPor cierto… ¿Sabes cómo usar\nel TELÉFONO?", MSGBOX_YESNO)
    	_: msgbox("Come home to adjust your clock for\n"
                   "Daylight Saving Time.\p"
                   "By the way, do you know how to\n"
                   "use the PHONE?", MSGBOX_YESNO)
    }

    if (var(VAR_RESULT) == NO)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Te leeré las instrucciones.\pEnciende el {POKE}GEAR y elige\nel TELÉFONO.\pLos números están en la memoria.\nElige el nombre que quieras.\p¿No te parece estupendo?")
        	_: msgbox("I'll read the instructions.\p"
                       "“Turn the {POKE}GEAR on and select\n"
                       "the PHONE icon by scrolling to it.\p"
                       "“Phone numbers are stored in memory.\n"
                       "Just choose who you want to call.”\p"
                       "Gee, isn't that convenient?")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿Recuerdas que hay que encender el\n{POKE}GEAR y elegir el TELÉFONO?\pLos números están en la memoria.\nElige el nombre que quieras.\p¿No te parece estupendo?")
        	_: msgbox("Don't you just turn the {POKE}GEAR on\n"
                       "and select the PHONE icon?\p"
                       "“Phone numbers are stored in memory.\n"
                       "Just choose who you want to call.”\p"
                       "Gee, isn't that convenient?")
        }
    }

    closemessage
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    applymovement(OBJ_EVT_MOM, NewBarkTown_PlayersHouse_1F_MomWalkAwayFromPlayer)
    waitmovement(0)
    setvar(VAR_PLAYER_HOUSE_STATE, 1)
    setrespawn(HEAL_LOCATION_NEW_BARK_TOWN)   // TODO: This should really be for player's room 2F, or do the FR approach
    releaseall
}

script NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek {
        poryswitch(LANGUAGE) {
    	SPANISH: message("¿Qué día es hoy?")
    	_: message("What day is it?")
    }
    waitmessage
    setvar(VAR_0x8004, SCROLL_MULTI_DAY_OF_WEEK)
    setvar(VAR_0x8005, 0)
    special(ShowScrollableMultichoice)
    waitstate
    copyvar(VAR_0x8004, VAR_RESULT)
    special(CopyDayOfWeekStringToVar1)
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¿{STR_VAR_1}, verdad?", MSGBOX_YESNO)
    	_: msgbox("{STR_VAR_1}, is it?", MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek)
    }
    special(SetDayOfWeek)
}

script NewBarkTown_PlayersHouse_1F_MomDaylightSaving {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¿Es horario de verano ahora?", MSGBOX_YESNO)
    	_: msgbox("Is it Daylight Saving Time now?", MSGBOX_YESNO)
    }
    special(WriteCurrentTimeStringToStrVar1)

    if (var(VAR_RESULT) == NO)
    {
        copyvar(VAR_0x8004, VAR_RESULT)
        special(SetInitialDSTMode)
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿{STR_VAR_1}, es correcto?", MSGBOX_YESNO)
        	_: msgbox("{STR_VAR_1}, is that correct?", MSGBOX_YESNO)
        }
    }
    else
    {
        copyvar(VAR_0x8004, VAR_RESULT)
        special(SetInitialDSTMode)
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿{STR_VAR_1} (horario de verano), es correcto?", MSGBOX_YESNO)
        	_: msgbox("{STR_VAR_1} DST, is that correct?", MSGBOX_YESNO)
        }
    }
    
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_PlayersHouse_1F_MomDaylightSaving)
    }
}

movement NewBarkTown_PlayersHouse_1F_MomWalkToPlayer {
    walk_up
    walk_right
    walk_up
}

movement NewBarkTown_PlayersHouse_1F_MomWalkAwayFromPlayer {
    walk_down
    walk_left
    walk_down
    walk_in_place_fastest_left
}

script NewBarkTown_PlayersHouse_1F_MomTalk {
    lock
    faceplayer
    if (flag(FLAG_PLAYER_MUST_LEAVE_HOUSE_TO_BANK_WITH_MOM))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("MAMÁ: ¡{PLAYER}, hazlo!\n¡Te apoyo con todo mi corazón!")
        	_: msgbox("MOM: {PLAYER}, do it!\n"
                       "I'm behind you all the way!")
        }
    }
    elif (flag(FLAG_TALKED_TO_MOM_AFTER_MYSTERY_EGG_QUEST))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("MAMÁ: ¡Hola! ¡Bienvenid{KUN} a casa!\nVeo que lo estás intentando mucho.\pHe mantenido tu habitación ordenada…\n¿O es por tu dinero?", MSGBOX_YESNO)
        	_: msgbox("MOM: Hi! Welcome home!\n"
                       "You're trying very hard, I see.\p"
                       "I've kept your room tidy…\n"
                       "Or is this about your money?", MSGBOX_YESNO)
        }
        if (var(VAR_RESULT) == YES)
        {
            goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBank)
        }
        else
        {
            gettime
            special(GetDSTMode)
            if (var(VAR_RESULT) == TRUE)
            {
                if (var(VAR_0x8000) == 0) // 12 AM
                {
                    call(NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet)
                }
                else
                {
                                        poryswitch(LANGUAGE) {
                    	SPANISH: msgbox("¿Ha terminado el horario de verano?", MSGBOX_YESNO)
                    	_: msgbox("Is Daylight Saving Time over?", MSGBOX_YESNO)
                    }
                    if (var(VAR_RESULT) == YES)
                    {
                        special(SwitchDSTMode)
                                                poryswitch(LANGUAGE) {
                        	SPANISH: msgbox("He atrasado el reloj una hora.")
                        	_: msgbox("I put the clock back one hour.")
                        }
                    }
                }
            }
            else
            {
                if (var(VAR_0x8000) == 23) // 11 PM
                {
                    call(NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet)
                }
                else
                {
                                        poryswitch(LANGUAGE) {
                    	SPANISH: msgbox("¿Quieres cambiar al horario\nde verano?", MSGBOX_YESNO)
                    	_: msgbox("Do you want to switch to Daylight\n"
                                   "Saving Time?", MSGBOX_YESNO)
                    }
                    if (var(VAR_RESULT) == YES)
                    {
                        special(SwitchDSTMode)
                                                poryswitch(LANGUAGE) {
                        	SPANISH: msgbox("He adelantado el reloj una hora.")
                        	_: msgbox("I set the clock forward by one hour.")
                        }
                    }
                }
            }
        }
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
    elif (flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
    {
        setflag(FLAG_TALKED_TO_MOM_AFTER_MYSTERY_EGG_QUEST)
        setflag(FLAG_PLAYER_MUST_LEAVE_HOUSE_TO_BANK_WITH_MOM)
        setvar(VAR_ROUTE31_STATE, 1)
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("MAMÁ: Vaya, ¡qué {POKEMON} tan mono!\n¿De dónde lo has sacado?\p…\pAsí que te vas de aventuras…\p¡Está bien! Yo también te ayudaré.\nPero, ¿qué puedo hacer por ti?\p¡Ya lo sé!\n¡Guardaré dinero para ti!\pEn un viaje tan largo, el dinero\nes muy importante.\p¿Quieres que te guarde el dinero?", MSGBOX_YESNO)
        	_: msgbox("MOM: Wow, that's a cute {POKEMON}.\n"
                       "Where did you get it?\p"
                       "…\p"
                       "So, you're leaving on an adventure…\p"
                       "Okay! I'll help too.\n"
                       "But what can I do for you?\p"
                       "I know!\n"
                       "I'll save money for you.\p"
                       "On a long journey, money is very\n"
                       "important.\p"
                       "Do you want me to save your money?", MSGBOX_YESNO)
        }
        if (var(VAR_RESULT) == YES)
        {
            setflag(FLAG_SYS_MOM_BANKING_ENABLED)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("Vale, me encargo de tu dinero.\n………………")
            	_: msgbox("Okay, I'll take care of your money.\n"
                           "………………")
            }
        }
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Ten cuidado.\pLos {POKEMON} son tus amigos.\nTenéis que trabajar en equipo.\p¡Ahora, adelante!")
        	_: msgbox("Be careful.\p"
                       "{POKEMON} are your friends.\n"
                       "You need to work as a team.\p"
                       "Now, go on!")
        }
    }
    elif (flag(FLAG_SYS_POKEMON_GET))
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("MAMÁ: Entonces, ¿cuál era el encargo\ndel PROF. ELM?\p…\nParece muy difícil.\pDeberías sentirte orgullos{KUN}\nde que la gente confíe en ti.")
        	_: msgbox("MOM: So, what was PROF. ELM's\n"
                       "errand?\p"
                       "…\n"
                       "That does sound challenging.\p"
                       "But, you should be proud that\n"
                       "people rely on you.")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("MAMÁ: El PROF. ELM te está esperando.\n¡Date prisa!")
        	_: msgbox("MOM: PROF. ELM is waiting for you.\n"
                       "Hurry up, baby!")
        }
    }
    release
}

text NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan {
    poryswitch(LANGUAGE) {
        SPANISH: "Haz lo que puedas."
        _: "Just do what you can."
    }
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBank {
        poryswitch(LANGUAGE) {
    	SPANISH: message("¿Qué quieres hacer?")
    	_: message("What do you want to do?")
    }
    waitmessage
    multichoice(0, 0, MULTI_MOM_BANK, FALSE)
    switch (var(VAR_RESULT))
    {
    case 0:
        // take
        call(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    case 1:
        // deposit
        call(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    case 2:
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¿Quieres que te guarde dinero?", MSGBOX_YESNO)
        	_: msgbox("Do you want to save some money?", MSGBOX_YESNO)
        }
        if (var(VAR_RESULT) == YES)
        {
            setflag(FLAG_SYS_MOM_BANKING_ENABLED)
                        poryswitch(LANGUAGE) {
            	SPANISH: msgbox("Vale, guardaré tu dinero.\n¡Confía en mí!\p¡{PLAYER}, no te rindas!")
            	_: msgbox("Okay, I'll save your money.\n"
                           "Trust me!\p"
                           "{PLAYER}, stick with it!")
            }
        }
        else
        {
            clearflag(FLAG_SYS_MOM_BANKING_ENABLED)
            msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
        }
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
    release
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw {
    setvar(VAR_0x8004, 0)
    special(MomBank)
    waitstate
    switch (var(VAR_RESULT))
    {
    case 0:
        // withdraw success
        playse(SE_SHOP)
        waitse
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡{PLAYER}, no te rindas!")
        	_: msgbox("{PLAYER}, don't give up!")
        }
    case 1:
        // not enough in bank
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("No has ahorrado tanto.")
        	_: msgbox("You haven't saved that much.")
        }
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    case 2:
        // too much in wallet
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("No puedes retirar tanto.")
        	_: msgbox("You can't take that much.")
        }
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit {
    setvar(VAR_0x8004, 1)
    special(MomBank)
    waitstate
    switch (var(VAR_RESULT))
    {
    case 0:
        // deposit success
        playse(SE_SHOP)
        waitse
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Tu dinero está a salvo aquí!\n¡Adelante!")
        	_: msgbox("Your money's safe here!\n"
                        "Get going!")
        }
    case 1:
        // not enough in wallet
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("No tienes tanto.")
        	_: msgbox("You don't have that much.")
        }
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    case 2:
        // too much in bank
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("No puedes ahorrar tanto.")
        	_: msgbox("You can't save that much.")
        }
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("¿Quieres ajustar el reloj para el\nhorario de verano?", MSGBOX_YESNO)
    	_: msgbox("Do you want to adjust your clock for\n"
                   "Daylight Saving Time?", MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == YES)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("Creo que he perdido el manual\nde instrucciones del {POKE}GEAR…\pTengo que ir a buscarlo.\nVuelve dentro de un rato.")
        	_: msgbox("I think I lost the instruction\n"
                       "booklet for the {POKE}GEAR…\p"
                       "I need to go look for it.\n"
                       "Come back again in a while.")
        }
    }
}

script NewBarkTown_PlayersHouse_1F_NeighborTalk {
    lock
    faceplayer
    gettime
    if (var(VAR_0x8002) == TIME_MORNING)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Buenos días, {PLAYER}!\n¡Estoy de visita!\p", MSGBOX_CONTINUE)
        	_: msgbox("Good morning, {PLAYER}!\n"
                       "I'm visiting!\p", MSGBOX_CONTINUE)
        }
    }
    elif (var(VAR_0x8002) == TIME_DAY)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Hola, {PLAYER}!\n¡Estoy de visita!\p", MSGBOX_CONTINUE)
        	_: msgbox("Hello, {PLAYER}!\n"
                       "I'm visiting!\p", MSGBOX_CONTINUE)
        }
    }
    elif (var(VAR_0x8002) == TIME_NIGHT)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Buenas tardes, {PLAYER}!\n¡Estoy de visita!\p", MSGBOX_CONTINUE)
        	_: msgbox("Good evening, {PLAYER}!\n"
                       "I'm visiting!\p", MSGBOX_CONTINUE)
        }
    }
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("{PLAYER}, ¿has oído?\pMi hija está empeñada en ser\nayudante del PROF. ELM.\l¡Le encantan los {POKEMON}!")
    	_: msgbox("{PLAYER}, have you heard?\p"
                   "My daughter is adamant about\n"
                   "becoming PROF. ELM's assistant.\l"
                   "She really loves {POKEMON}!")
    }
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFastestRight)
    waitmovement(0)
    release
}

script NewBarkTown_PlayersHouse_1F_TV {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Están poniendo una peli...\nLas estrellas iluminan el cielo mientras\ldos chicos viajan en un tren…\pBueno, voy a ponerme en marcha.", MSGBOX_SIGN)
    	_: msgbox("There's a movie on TV.\n"
                   "Stars dot the sky as two boys\l"
                   "ride on a train…\p"
                   "I'd better get rolling too!", MSGBOX_SIGN)
    }
}

script NewBarkTown_PlayersHouse_1F_Stove {
    lock
    random(1000)
    if (var(VAR_RESULT) == 0)
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("UN ANUNCIO PUBLICITARIO PARA MAMÁ\nVOLCANO BAKEMEAT.")
        	_: msgbox("A ADEPT ARRANGING FOR MOTHER\n"
                       "VOLCANO BAKEMEAT.")
        }
    }
    else
    {
                poryswitch(LANGUAGE) {
        	SPANISH: msgbox("¡Es la especialidad de mamá,\nla HAMBURGUESA VOLCÁN CANELA!")
        	_: msgbox("It's Mom's specialty, the\n"
                       "CINNABAR VOLCANO BURGER!")
        }
    }
    release
}

script NewBarkTown_PlayersHouse_1F_Sink {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("El fregadero está impecable.\nA mamá le gusta mantenerlo limpio.", MSGBOX_SIGN)
    	_: msgbox("The sink is spotless.\n"
                   "Mom likes to keep it clean.", MSGBOX_SIGN)
    }
}

script NewBarkTown_PlayersHouse_1F_Fridge {
        poryswitch(LANGUAGE) {
    	SPANISH: msgbox("Veamos qué hay en la nevera…\p¡AGUA FRESCA y rica LIMONADA!", MSGBOX_SIGN)
    	_: msgbox("Let's see what's in the fridge…\p"
                   "FRESH WATER and tasty LEMONADE!", MSGBOX_SIGN)
    }
}
