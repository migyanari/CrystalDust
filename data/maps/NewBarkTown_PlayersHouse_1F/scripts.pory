const OBJ_EVT_MOM = 1

mapscripts NewBarkTown_PlayersHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_PLAYER_HOUSE_STATE) != 0)
        {
            gettime
            if (var(VAR_0x8002) == TIME_MORNING)
            {
                setobjectxyperm(OBJ_EVT_MOM, 2, 2)
                setobjectmovementtype(OBJ_EVT_MOM, MOVEMENT_TYPE_FACE_UP)
            }
            elif (var(VAR_0x8002) == TIME_NIGHT)
            {
                setobjectxyperm(OBJ_EVT_MOM, 1, 2)
                setobjectmovementtype(OBJ_EVT_MOM, MOVEMENT_TYPE_FACE_UP)
            }
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_PLAYER_HOUSE_STATE, 0 : NewBarkTown_PlayersHouse_1F_MomEncounter
    ]
}

script NewBarkTown_PlayersHouse_1F_MomEncounter {
    lockall
    textcolor(MSG_COLOR_RED)
    playse(SE_PIN)
    applymovement(OBJ_EVT_MOM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(OBJ_EVT_MOM, Common_Movement_Delay48)
    waitmovement(0)
    playbgm(MUS_MOMS_THEME, 0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFastestDown)
    applymovement(OBJ_EVT_MOM, NewBarkTown_PlayersHouse_1F_MomWalkToPlayer)
    waitmovement(0)
    delay(20)
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_MOMOhP)
    textcolor(MSG_COLOR_PREV)
    playfanfare(MUS_OBTAIN_ITEM)
                message(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ReceivedThePOKEGEAR)
    waitfanfare
    setflag(FLAG_SYS_POKEGEAR_GET)
    setflag(FLAG_PHONE_CARD_MOM)
    textcolor(MSG_COLOR_RED)
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_PokemonGEAROrJust)
    call(NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek)
    call(NewBarkTown_PlayersHouse_1F_MomDaylightSaving)
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ComeHomeToAdjust, MSGBOX_YESNO)

    if (var(VAR_RESULT) == NO)
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ILlReadThe)
    }
    else
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_DonTYouJust)
    }

    closemessage
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    applymovement(OBJ_EVT_MOM, NewBarkTown_PlayersHouse_1F_MomWalkAwayFromPlayer)
    waitmovement(0)
    setvar(VAR_PLAYER_HOUSE_STATE, 1)
    setrespawn(HEAL_LOCATION_NEW_BARK_TOWN)   // TODO: This should really be for player's room 2F, or do the FR approach
    releaseall
}

script NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek {
                message(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek_WhatDayIsIt)
    waitmessage
    setvar(VAR_0x8004, SCROLL_MULTI_DAY_OF_WEEK)
    setvar(VAR_0x8005, 0)
    special(ShowScrollableMultichoice)
    waitstate
    copyvar(VAR_0x8004, VAR_RESULT)
    special(CopyDayOfWeekStringToVar1)
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek_STR_VAR_1IsIt, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_PlayersHouse_1F_MomWhatDayOfWeek)
    }
    special(SetDayOfWeek)
}

script NewBarkTown_PlayersHouse_1F_MomDaylightSaving {
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomDaylightSaving_IsItDaylightSaving, MSGBOX_YESNO)
    special(WriteCurrentTimeStringToStrVar1)

    if (var(VAR_RESULT) == NO)
    {
        copyvar(VAR_0x8004, VAR_RESULT)
        special(SetInitialDSTMode)
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomDaylightSaving_STR_VAR_1IsThatCorrect, MSGBOX_YESNO)
    }
    else
    {
        copyvar(VAR_0x8004, VAR_RESULT)
        special(SetInitialDSTMode)
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomDaylightSaving_STR_VAR_1DSTIsThat, MSGBOX_YESNO)
    }
    
    if (var(VAR_RESULT) == NO)
    {
        goto(NewBarkTown_PlayersHouse_1F_MomDaylightSaving)
    }
}

movement NewBarkTown_PlayersHouse_1F_MomWalkToPlayer {
    walk_up
    walk_right
    walk_up
}

movement NewBarkTown_PlayersHouse_1F_MomWalkAwayFromPlayer {
    walk_down
    walk_left
    walk_down
    walk_in_place_fastest_left
}

script NewBarkTown_PlayersHouse_1F_MomTalk {
    lock
    faceplayer
    if (flag(FLAG_PLAYER_MUST_LEAVE_HOUSE_TO_BANK_WITH_MOM))
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMDoItI)
    }
    elif (flag(FLAG_TALKED_TO_MOM_AFTER_MYSTERY_EGG_QUEST))
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMHiWelcomeHome, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBank)
        }
        else
        {
            gettime
            special(GetDSTMode)
            if (var(VAR_RESULT) == TRUE)
            {
                if (var(VAR_0x8000) == 0) // 12 AM
                {
                    call(NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet)
                }
                else
                {
                                                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_IsDaylightSavingTime, MSGBOX_YESNO)
                    if (var(VAR_RESULT) == YES)
                    {
                        special(SwitchDSTMode)
                                                                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_IPutTheClock)
                    }
                }
            }
            else
            {
                if (var(VAR_0x8000) == 23) // 11 PM
                {
                    call(NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet)
                }
                else
                {
                                                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_DoYouWantTo, MSGBOX_YESNO)
                    if (var(VAR_RESULT) == YES)
                    {
                        special(SwitchDSTMode)
                                                                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_ISetTheClock)
                    }
                }
            }
        }
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
    elif (flag(FLAG_GAVE_MYSTERY_EGG_TO_ELM))
    {
        setflag(FLAG_TALKED_TO_MOM_AFTER_MYSTERY_EGG_QUEST)
        setflag(FLAG_PLAYER_MUST_LEAVE_HOUSE_TO_BANK_WITH_MOM)
        setvar(VAR_ROUTE31_STATE, 1)
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMWowThatS, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            setflag(FLAG_SYS_MOM_BANKING_ENABLED)
                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_OkayILlTake)
        }
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_BeCarefulPPokemon)
    }
    elif (flag(FLAG_SYS_POKEMON_GET))
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMSoWhatWas)
    }
    else
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMPROFELMIs)
    }
    release
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBank {
                message(NewBarkTown_PlayersHouse_1F_Text_MomBank_WhatDoYouWant)
    waitmessage
    multichoice(0, 0, MULTI_MOM_BANK, FALSE)
    switch (var(VAR_RESULT))
    {
    case 0:
        // take
        call(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    case 1:
        // deposit
        call(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    case 2:
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBank_DoYouWantTo, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            setflag(FLAG_SYS_MOM_BANKING_ENABLED)
                                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBank_OkayILlSave)
        }
        else
        {
            clearflag(FLAG_SYS_MOM_BANKING_ENABLED)
            msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
        }
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
    release
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw {
    setvar(VAR_0x8004, 0)
    special(MomBank)
    waitstate
    switch (var(VAR_RESULT))
    {
    case 0:
        // withdraw success
        playse(SE_SHOP)
        waitse
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_DonTGiveUp)
    case 1:
        // not enough in bank
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_YouHavenTSaved)
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    case 2:
        // too much in wallet
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankWithdraw_YouCanTTake)
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankWithdraw)
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit {
    setvar(VAR_0x8004, 1)
    special(MomBank)
    waitstate
    switch (var(VAR_RESULT))
    {
    case 0:
        // deposit success
        playse(SE_SHOP)
        waitse
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YourMoneySSafe)
    case 1:
        // not enough in wallet
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YouDonTHave)
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    case 2:
        // too much in bank
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomBankDeposit_YouCanTSave)
        goto(NewBarkTown_PlayersHouse_1F_EventScript_MomBankDeposit)
    default:
        msgbox(NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan)
    }
}

script NewBarkTown_PlayersHouse_1F_EventScript_MomLostBooklet {
                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomLostBooklet_DoYouWantTo, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_MomLostBooklet_IThinkILost)
    }
}

script NewBarkTown_PlayersHouse_1F_NeighborTalk {
    lock
    faceplayer
    gettime
    if (var(VAR_0x8002) == TIME_MORNING)
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_GoodMorningIM, MSGBOX_CONTINUE)
    }
    elif (var(VAR_0x8002) == TIME_DAY)
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_HelloIMVisiting, MSGBOX_CONTINUE)
    }
    elif (var(VAR_0x8002) == TIME_NIGHT)
    {
                                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_GoodEveningIM, MSGBOX_CONTINUE)
    }
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_NeighborTalk_HaveYouHeardP)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFastestRight)
    waitmovement(0)
    release
}

script NewBarkTown_PlayersHouse_1F_TV {
                msgbox(NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_TV_ThereSAMovie, MSGBOX_SIGN)
}

