text NewBarkTown_PlayersHouse_1F_EventScript_MomJustDoWhatYouCan {
    poryswitch(LANGUAGE) {
        SPANISH: "Haz lo que puedas."
        _: "Just do what you can."
    }
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_MOMOhP {
	poryswitch(LANGUAGE) {
		SPANISH: "MAMÁ: ¡Ah, {PLAYER}…!\pNuestro vecino, el PROF. ELM,\nte estaba buscando.\pDijo que quería que le hicieras\nun favor.\p¡Ah! ¡Casi se me olvidaba!\nYa han traído tu {POKE}GEAR\ldel taller.\l¡Aquí tienes!"
		_: "MOM: Oh, {PLAYER}…!\p"
                   "Our neighbor, PROF. ELM, was just\n"
                   "looking for you.\p"
                   "He said he wanted you to do\n"
                   "something for him.\p"
                   "Oh, I almost forgot! Your {POKEMON}\n"
                   "GEAR is back from the repair shop.\l"
                   "Here you go!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ReceivedThePOKEGEAR {
	poryswitch(LANGUAGE) {
		SPANISH: "{PLAYER} recibió el {POKE}GEAR."
		_: "{PLAYER} received the {POKE}GEAR."
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_PokemonGEAROrJust {
	poryswitch(LANGUAGE) {
		SPANISH: "El {POKEMON} GEAR, o simplemente\n{POKE}GEAR.\nEs básico para ser un buen ENTRENADOR.\p¡Ah! Falta el día de la semana.\n¡No olvides ponerlo!"
		_: "{POKEMON} GEAR, or just {POKE}GEAR.\n"
                   "It's essential if you want to be\l"
                   "a good TRAINER.\p"
                   "Oh, the day of the week isn't set.\n"
                   "You mustn't forget that!"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ComeHomeToAdjust {
	poryswitch(LANGUAGE) {
		SPANISH: "Vuelve a casa para cambiar de hora\nel reloj.\pPor cierto… ¿Sabes cómo usar\nel TELÉFONO?"
		_: "Come home to adjust your clock for\n"
                   "Daylight Saving Time.\p"
                   "By the way, do you know how to\n"
                   "use the PHONE?"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_ILlReadThe {
	poryswitch(LANGUAGE) {
		SPANISH: "Te leeré las instrucciones.\pEnciende el {POKE}GEAR y elige\nel TELÉFONO.\pLos números están en la memoria.\nElige el nombre que quieras.\p¿No te parece estupendo?"
		_: "I'll read the instructions.\p"
                   "“Turn the {POKE}GEAR on and select\n"
                   "the PHONE icon by scrolling to it.\p"
                   "“Phone numbers are stored in memory.\n"
                   "Just choose who you want to call.”\p"
                   "Gee, isn't that convenient?"
	}
}

text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomEncounter_DonTYouJust {
	poryswitch(LANGUAGE) {
		SPANISH: "¿Recuerdas que hay que encender el\n{POKE}GEAR y elegir el TELÉFONO?\pLos números están en la memoria.\nElige el nombre que quieras.\p¿No te parece estupendo?"
		_: "Don't you just turn the {POKE}GEAR on\n"
                   "and select the PHONE icon?\p"
                   "“Phone numbers are stored in memory.\n"
                   "Just choose who you want to call.”\p"
                   "Gee, isn't that convenient?"
	}
}

