text NewBarkTown_PlayersHouse_1F_Text_NewBarkTown_PlayersHouse_1F_MomTalk_MOMHiWelcomeHome {
	poryswitch(LANGUAGE) {
		SPANISH: "MAMÁ: ¡Hola! ¡Bienvenid{KUN} a casa!\nVeo que lo estás intentando mucho.\pHe mantenido tu habitación ordenada…\n¿O es por tu dinero?"
		_: "MOM: Hi! Welcome home!\n"
                   "You're trying very hard, I see.\p"
                   "I've kept your room tidy…\n"
                   "Or is this about your money?"
	}
}

