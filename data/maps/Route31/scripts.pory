mapscripts Route31_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_ROUTE31_STATE, 0 {
            lockall
            setflag(FLAG_HIDE_MAP_NAME_POPUP)
            pokegearcall(PhoneScript_Mom, 0)
            waitstate
            clearflag(FLAG_HIDE_MAP_NAME_POPUP)
            setvar(VAR_ROUTE31_STATE, 1)
            releaseall
        }
    ]
}

script Route31_EventScript_Explorer {
    msgbox(Route31_Text_Explorer, MSGBOX_NPC)
}

script Route31_EventScript_SleepyMan {
    lock
    faceplayer
    if (flag(FLAG_MOVE_TUTOR_TAUGHT_NIGHTMARE)) {
        msgbox(Route31_Text_SleepyMan_NightmareDescription)
    }
    elif(flag(FLAG_GAVE_KENYA_TO_RANDYS_FRIEND)) {
        bufferstring(0, Route31_Text_SleepyMan_NightmareOffering)
        msgbox(Route31_Text_SleepyMan_ThanksAgainForMail, MSGBOX_YESNO)
        if (var (VAR_RESULT)) {
            call(Route31_EventScript_SleepyMan_TryTeachNightmare)
        } else {
            msgbox(Route31_Text_SleepyMan_NightmareDeclined)
        }
    }
    elif(flag(FLAG_GOT_KENYA_FROM_RANDY)) {
        msgbox(Route31_Text_SleepyMan_GotMail, MSGBOX_YESNO)
        special(ChoosePartyMon)
        waitstate
        lock
        faceplayer
        if (var (VAR_0x8004) != 0xFF) {
            setvar(VAR_0x8005, INGAME_TRADE_GIFT_SPEAROW)
            special(CheckForGiftMonAndTakeMail)
            switch (var (VAR_RESULT)) {
                case GIFTMON_NO_MAIL:
                    msgbox(Route31_Text_SleepyMan_MissingMail, MSGBOX_AUTOCLOSE)
                case GIFTMON_LAST_MON:
                    msgbox(Route31_Text_SleepyMan_CantTakeLastMon, MSGBOX_AUTOCLOSE)
                case GIFTMON_WRONG_MAIL:
                    msgbox(Route31_Text_SleepyMan_WrongMail)
                default:
                    if (var (VAR_RESULT) == GIFTMON_WRONG_MON) {
                        msgbox(Route31_Text_SleepyMan_WrongMon)
                        textcolor(MSG_COLOR_SYS)
                        playfanfare(MUS_OBTAIN_ITEM)
                        message(Route31_Text_SleepyMan_HandedOverMail)
                    }
                    else {// GIFTMON_MATCH
                        textcolor(MSG_COLOR_SYS)
                        playfanfare(MUS_OBTAIN_ITEM)
                        msgbox(Route31_Text_SleepyMan_HandedOverMailMon)
                    }
                    setflag(FLAG_GAVE_KENYA_TO_RANDYS_FRIEND)
                    waitmessage
                    waitfanfare
                    textcolor(MSG_COLOR_PREV)
                    bufferstring(0, Route31_Text_SleepyMan_NightmareOffering)
                    msgbox(Route31_Text_SleepyMan_ReadingMail, MSGBOX_YESNO)
                    if (var (VAR_RESULT)) {
                        call(Route31_EventScript_SleepyMan_TryTeachNightmare)
                    } else {
                        msgbox(Route31_Text_SleepyMan_NightmareDeclined)
                    }
            }
        } else {
            msgbox(Route31_Text_SleepyMan_Declined)
        }
    }
    else {
        msgbox(Route31_Text_SleepyMan)
    }
    release
}

script Route31_EventScript_SleepyMan_TryTeachNightmare {
    call(MoveTutor_EventScript_CanOnlyBeLearnedOnce)
    if (!var(VAR_RESULT)) {
        goto(MoveTutor_EventScript_NightmareDeclined)
    }
    msgbox(Route31_Text_SleepyMan_WhichPokemonLearn, MSGBOX_DEFAULT)
    setvar(VAR_0x8005, TUTOR_MOVE_NIGHTMARE)
    call(MoveTutor_EventScript_OpenPartyMenu)
    if (var (VAR_RESULT) == 0) {
        goto(MoveTutor_EventScript_NightmareDeclined)
    }
    setflag(FLAG_MOVE_TUTOR_TAUGHT_NIGHTMARE)
    goto(Route31_EventScript_SleepyMan)
    end
}

script MoveTutor_EventScript_NightmareDeclined {
    msgbox(Route31_Text_SleepyMan_NightmareDeclined)
    release
    end
}

script Route31_EventScript_Youngster {
    msgbox(Route31_Text_Youngster, MSGBOX_NPC)
}

script Route31_EventScript_Trainer_Wade {
    trainerbattle_single(TRAINER_WADE_1, Route31_Text_Trainer_Wade_Seen, Route31_Text_Trainer_Wade_Lost)

    if(flag(FLAG_CALL_WADE_GIFT))
    {
        msgbox(Route31_Text_Trainer_Wade_Gift, MSGBOX_AUTOCLOSE)
        random(42)
        addvar(VAR_RESULT,133)
        giveitem(VAR_RESULT, 1)
        if(var(VAR_0x8007) == FALSE)
        {
            msgbox(Route31_Text_Trainer_Wade_PackFull, MSGBOX_AUTOCLOSE)
        }
        else
        {
            clearflag(FLAG_CALL_WADE_GIFT)
        }
    }
    specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if(var(VAR_RESULT) == TRUE)
    {
        trainerbattle_rematch(TRAINER_WADE_1, Route31_Text_Trainer_Wade_Rematch, Route31_Text_Trainer_Wade_Lost)
    }

    if (!flag(FLAG_PHONE_CARD_BUG_CATCHER_WADE))
    {
        if (!flag(FLAG_BUG_CATCHER_WADE_OFFERED_NUMBER))
        {
            bufferstring(0, Route31_Text_Trainer_Wade_AskNumber)
            msgbox(Route31_Text_Trainer_Wade_AfterBeaten, MSGBOX_YESNO)
            setflag(FLAG_BUG_CATCHER_WADE_OFFERED_NUMBER)
        }
        else
        {
            msgbox(Route31_Text_Trainer_Wade_AskNumber, MSGBOX_YESNO)
        }
        if (var (VAR_RESULT) == YES)
        {
            registerphonecontact(FLAG_PHONE_CARD_BUG_CATCHER_WADE)
            msgbox(Route31_Text_Trainer_Wade_AfterRegistered, MSGBOX_AUTOCLOSE)
        }
        else
        {
            msgbox(Route31_Text_Trainer_Wade_AfterDeclined, MSGBOX_AUTOCLOSE)
        }
        end
    }
    msgbox(Route31_Text_Trainer_Wade_AfterRegistered, MSGBOX_AUTOCLOSE)
    release
}

script Route31_EventScript_Directions {
    msgbox(Route31_Text_DirectionsSign, MSGBOX_SIGN)
}

script Route31_EventScript_DarkCave {
    msgbox(Route31_Text_DarkCaveSign, MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// Texts
// ---------------------------------------------------------------------------

text Route31_Text_Explorer {
    poryswitch(LANGUAGE) {
        SPANISH: "CUEVA OSCURA…\pSi los {POKEMON} pudieran iluminarla,\nla exploraría."
        _: "DARK CAVE…\pIf {POKEMON} could light it up, I'd\nexplore it."
    }
}

text Route31_Text_SleepyMan_NightmareOffering {
    poryswitch(LANGUAGE) {
        SPANISH: "Mi amigo es un buen tipo,\n¡y tú también!\p¡Me gustaría devolverte\nel favor!\p¡Ya sé!\p¿Qué te parece si le enseño PESADILLA\na uno de tus {POKEMON}?"
        _: "My friend's a good guy, and you're\nswell too!\pI'd like to do something good in\nreturn for your help!\pI know!\pHow about I teach your {POKEMON}\nNIGHTMARE for helping me?"
    }
}

text Route31_Text_SleepyMan_ThanksAgainForMail {
    poryswitch(LANGUAGE) {
        SPANISH: "Zzzz… ¿Eh?\p¡Ah, eres tú otra vez! Gracias de nuevo\npor traerme aquella CARTA.\p{STR_VAR_1}"
        _: "…Zzzz…\nHuh?\pOh, it's you again! Thanks for\nbringing that MAIL to me.\p{STR_VAR_1}"
    }
}

text Route31_Text_SleepyMan_Declined {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Qué?\n¿No quieres nada?"
        _: "What?\nYou don't want anything?"
    }
}

text Route31_Text_SleepyMan_NightmareDeclined {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Qué?\n¿No quieres aprender PESADILLA?"
        _: "What?\nYou don't want to learn NIGHTMARE?"
    }
}

text Route31_Text_SleepyMan_WhichPokemonLearn {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Qué {POKEMON} debería aprender\nPESADILLA?"
        _: "Which {POKEMON} should learn\nNIGHTMARE?"
    }
}

text Route31_Text_SleepyMan_NightmareDescription {
    poryswitch(LANGUAGE) {
        SPANISH: "PESADILLA es un movimiento terrible\nque reduce los PS de un rival dormido.\p¡Ooooh…!\n¡Qué miedo…!\pNo me gustan las pesadillas."
        _: "That's NIGHTMARE.\pIt's a wicked move that steadily cuts\nthe HP of a sleeping enemy.\pOoooh…\nThat's scary…\lI don't want to have bad dreams."
    }
}

text Route31_Text_SleepyMan_GotMail {
    poryswitch(LANGUAGE) {
        SPANISH: "Zzzz… ¿Eh?\p¿Qué es eso?\n¿Una CARTA para mí?"
        _: "…Zzzz…\nHuh?\pWhat's that?\nYou have MAIL for me?"
    }
}

text Route31_Text_SleepyMan_MissingMail {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Por qué es especial este {POKEMON}?\nNo tiene ninguna CARTA."
        _: "Why is this {POKEMON} so special?\nIt doesn't have any MAIL."
    }
}

text Route31_Text_SleepyMan_CantTakeLastMon {
    poryswitch(LANGUAGE) {
        SPANISH: "Si te quito ese {POKEMON},\n¿qué vas a usar en los combates?"
        _: "If I take that {POKEMON} from you,\nwhat are you going to use in battle?"
    }
}

text Route31_Text_SleepyMan_WrongMail {
    poryswitch(LANGUAGE) {
        SPANISH: "Esta CARTA no es para mí."
        _: "This MAIL isn't for me."
    }
}

text Route31_Text_SleepyMan_WrongMon {
    poryswitch(LANGUAGE) {
        SPANISH: "¿Eh?\n¿Qué {POKEMON} es ese?\nNo lo conozco.\pQuedátelo, cogeré solo la CARTA."
        _: "…Huh? Who's that {POKEMON}?\nIt's not one I know.\pYou can keep it, and I'll just\ntake the MAIL."
    }
}

text Route31_Text_SleepyMan_HandedOverMail {
    poryswitch(LANGUAGE) {
        SPANISH: "{PLAYER} entregó la CARTA."
        _: "{PLAYER} handed over the MAIL."
    }
}

text Route31_Text_SleepyMan_HandedOverMailMon {
    poryswitch(LANGUAGE) {
        SPANISH: "{PLAYER} entregó el {POKEMON}\nque lleva la CARTA."
        _: "{PLAYER} handed over the {POKEMON}\nholding the MAIL."
    }
}

text Route31_Text_SleepyMan_ReadingMail {
    poryswitch(LANGUAGE) {
        SPANISH: "Veamos…\p“La CUEVA OSCURA lleva a otro camino.”\pEs bueno saberlo.\nGracias por traerme esto.\p{STR_VAR_1}"
        _: "Let's see…\p“There's a dark place near you.\nLet's go have an adventure there!”\pDoes he mean DARK CAVE?\nThat sounds like fun.\pYou know, I heard that cave leads\nto another road.\pAnyway, thanks for bringing this\nto me.\p{STR_VAR_1}"
    }
}

text Route31_Text_SleepyMan {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Arg…! ¿Eh?\pHoy he caminado mucho\nbuscando {POKEMON}.\pMe duelen los pies\ny tengo sueño…\pSi fuera un {POKEMON} salvaje,\nsería fácil atraparme…\p¡Zzzz…!"
        _: "…Hnuurg… Huh?\pI walked too far today looking\nfor {POKEMON}.\pMy feet hurt and I'm sleepy…\pIf I were a wild {POKEMON}, I'd be\neasy to catch…\p…Zzzz…"
    }
}

text Route31_Text_Youngster {
    poryswitch(LANGUAGE) {
        SPANISH: "He encontrado un buen {POKEMON}\nen la CUEVA OSCURA.\pVoy a criarlo para\nenfrentarme a PEGASO.\nEs el LÍDER del GIMNASIO\nde CIUDAD MALVA."
        _: "I found a good {POKEMON} in\nDARK CAVE.\pI'm going to raise it to take on\nFALKNER, the leader of VIOLET\lCITY's GYM."
    }
}

text Route31_Text_Trainer_Wade_Seen {
    poryswitch(LANGUAGE) {
        SPANISH: "¡He atrapado un montón de {POKEMON}!\n¡Luchemos!"
        _: "I caught a bunch of {POKEMON}.\nLet me battle with you!"
    }
}

text Route31_Text_Trainer_Wade_Lost {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Auuuu…!"
        _: "Awwwww…"
    }
}

text Route31_Text_Trainer_Wade_Gift {
    poryswitch(LANGUAGE) {
        SPANISH: "¡Qué bien que has venido!\pEsto es lo que he encontrado.\n¡Es para ti!"
        _: "Good to see you!\pSee? This is what I found.\nIt's for you."
    }
}

text Route31_Text_Trainer_Wade_PackFull {
    poryswitch(LANGUAGE) {
        SPANISH: "Vaya, tu MOCHILA está llena.\nMala suerte.\pDeberías venir a recogerlo más tarde."
        _: "Oops, your PACK's full. Too bad.\nYou should come back for it later."
    }
}

text Route31_Text_Trainer_Wade_Rematch {
    poryswitch(LANGUAGE) {
        SPANISH: "Te esperaba.\n¡Luchemos!"
        _: "I was waiting for you!\nLet's battle!"
    }
}

text Route31_Text_Trainer_Wade_AskNumber {
    poryswitch(LANGUAGE) {
        SPANISH: "Cuando salgo al campo, encuentro toda\nclase de BAYAS.\pSi quieres, te daré algunas.\n¿Me das tu número de teléfono?"
        _: "When I'm in the grass, I find all\nkinds of BERRIES.\pIf you'd like, I'll share some.\nCould I get your phone number?"
    }
}

text Route31_Text_Trainer_Wade_AfterBeaten {
    poryswitch(LANGUAGE) {
        SPANISH: "Puedes atrapar {POKEMON} aunque\nya lleves seis contigo.\pSi atrapas alguno, más\nserá enviado a una CAJA.\p¡Eres increíble! ¡Me gustas!\nBusco {POKEMON} aquí todos los días.\p{STR_VAR_1}"
        _: "You can catch {POKEMON} even if\nyou have six with you.\pIf you catch one, it'll go to your\nBOX automatically.\pYou're awesome! I like you! I look\nfor {POKEMON} here every day.\p{STR_VAR_1}"
    }
}

text Route31_Text_Trainer_Wade_AfterRegistered {
    poryswitch(LANGUAGE) {
        SPANISH: "Oirás de mí tan pronto como encuentre\nalgo que te pueda gustar."
        _: "You'll hear from me as soon as I\nfind anything that you might like."
    }
}

text Route31_Text_Trainer_Wade_AfterDeclined {
    poryswitch(LANGUAGE) {
        SPANISH: "Bueno, no dudes en pedirme mi\nnúmero de teléfono."
        _: "Oh well. Don't be shy if you want\nto get my number."
    }
}

text Route31_Text_DirectionsSign {
    poryswitch(LANGUAGE) {
        SPANISH: "RUTA 31\nCIUDAD MALVA - CIUDAD CEREZO"
        _: "ROUTE 31\nVIOLET CITY - CHERRYGROVE CITY"
    }
}

text Route31_Text_DarkCaveSign {
    poryswitch(LANGUAGE) {
        SPANISH: "CUEVA OSCURA"
        _: "DARK CAVE"
    }
}